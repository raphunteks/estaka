      <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 14px;">
        Buka WhatsApp di ponsel &gt; <strong>Perangkat Tertaut</strong> &gt; <strong>Tautkan Perangkat</strong>.
      </p>

      <div id="qrLiveCardWrapper" class="qr-live-wrapper qr-live-pulse" style="margin: 0 auto 16px;">
        <div id="qrLoaderBox" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%;">
          <div class="qr-spinner"></div>
          <div id="qrLoaderMainText" style="font-size: 0.85rem; font-weight: 700; color: var(--cyan-deep); margin-top: 14px;">
            Menghubungkan ke Baileys di Railway...
          </div>
        </div>

        <img id="qrImageElement" src="" alt="QR Baileys" style="display: none; width: 224px; height: 224px; border-radius: 12px;">

        <div id="qrSuccessOverlay" style="display: none; position: absolute; inset: 0; background: rgba(255,255,255,0.96); border-radius: 18px; flex-direction: column; align-items: center; justify-content: center; padding: 20px;">
          <iconify-icon icon="solar:check-circle-bold" style="font-size: 64px; color: var(--success); margin-bottom: 8px;"></iconify-icon>
          <h4 style="color: var(--text-main); font-size: 1.1rem;">Bot Terhubung!</h4>
        </div>
      </div>

      <div id="qrStatusText" style="font-size: 0.86rem; color: var(--cyan-deep); font-weight: 600; margin-bottom: 16px;">
        Menunggu data QR Code dari Baileys...
      </div>

      <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
        <button type="button" class="cyber-btn-secondary" style="padding: 7px 12px; font-size: 0.82rem; color: var(--danger);" onclick="triggerResetRailwaySession()">
          <iconify-icon icon="solar:restart-bold"></iconify-icon>
          <span>Reset Sesi</span>
        </button>
        <button class="cyber-btn-secondary" onclick="closeModal('qrModal')">Tutup</button>
