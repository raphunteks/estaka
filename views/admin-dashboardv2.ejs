  </div>

  <!-- Modal Detail Pesan -->
  <div id="msgDetailModal" class="modal-overlay">
    <div class="modal-content">
      <h3 style="font-size: 1.2rem; margin-bottom: 14px; color: var(--cyan-deep);">Detail Pesan WhatsApp</h3>
      <div id="msgDetailBody" style="font-size: 0.88rem; line-height: 1.6; color: var(--text-main); background: rgba(0, 180, 216, 0.05); padding: 16px; border-radius: 10px; border: 1px solid var(--border-subtle); margin-bottom: 20px;"></div>
      <button class="cyber-btn-secondary" onclick="closeModal('msgDetailModal')">Tutup</button>
    </div>
  </div>

  <div id="toastContainer" class="toast-container"></div>

  <!-- SCRIPT ENGINE CLIENT TERPADU DENGAN UNIVERSAL DATA PARSER & CLOUD AUTO-SYNC -->
  <script>
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbzZ8HVyql76ZZbVY7qk8HISf9h8d8xfs6zb4NlrjUZu_MkEYlZMLbjoS300_ap80h-e/exec";
    const DEFAULT_RAILWAY_URL = "https://btwwa-akshra-production.up.railway.app";

    const appState = {
      user: null,
      activeQrSocket: null,
      qrPollingTimer: null,
      chatPage: 1,
      chatTotalPages: 1,
      queuePage: 1,
      queueTotalPages: 1,
      aiHistory: [],
      selectedModel: 'gemini-3.5-flash',
      availableModels: []
    };

    /**
     * UNIVERSAL MULTI-COMPATIBLE RUNBACKEND (Express V2 -> V1 -> GAS Web App)
     */
    function runBackend(functionName, args, onSuccess, onError) {
      args = args || [];
      let primaryPayload = {};
      if (args.length === 1 && typeof args[0] === 'object' && args[0] !== null) {
        primaryPayload = args[0];
      } else if (args.length > 1) {
        primaryPayload = { args: args };
      }

      const requestBody = {
        action: functionName,
        payload: primaryPayload,
        args: args,
        data: primaryPayload,
        username: primaryPayload.username || '',
        password: primaryPayload.password || ''
      };

      fetch('/api/v2/router', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      })
      .then(r => r.ok ? r.json() : Promise.reject('V2 status: ' + r.status))
      .then(data => { if (typeof onSuccess === 'function') onSuccess(data); })
      .catch(() => {
        fetch('/api/router', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        })
        .then(r => r.ok ? r.json() : Promise.reject('V1 status: ' + r.status))
        .then(data => { if (typeof onSuccess === 'function') onSuccess(data); })
        .catch(() => {
          fetch(GAS_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(requestBody)
          })
          .then(r => r.json())
          .then(data => { if (typeof onSuccess === 'function') onSuccess(data); })
          .catch(err => {
            if (typeof onError === 'function') onError(err);
            else showToast('Koneksi router gagal: ' + err.message, 'danger');
          });
        });
      });
    }

    /**
     * Permintaan data cadangan langsung ke Google Apps Script (Bypass Cache jika lokal kosong)
     */
    function fetchDirectFromGAS(functionName, payload, callback) {
      fetch(GAS_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action: functionName, payload: payload, args: [payload] })
      })
      .then(r => r.json())
      .then(data => callback(data))
      .catch(() => callback(null));
    }

    window.addEventListener('DOMContentLoaded', function() {
      checkSavedSession();
      loadAiModelCatalog();
    });

    function checkSavedSession() {
      const saved = sessionStorage.getItem('akshara_v2_user');
      if (saved) {
        try {
          appState.user = JSON.parse(saved);
          showDashboardView();
        } catch (e) {
          sessionStorage.removeItem('akshara_v2_user');
          showLoginGateView();
        }
      } else {
        showLoginGateView();
      }
    }

    function showDashboardView() {
      document.getElementById('portalLoginView').style.display = 'none';
      document.getElementById('portalDashboardView').style.display = 'block';
      document.getElementById('txtPortalAction').innerText = 'Keluar Sesi';
      document.getElementById('userNameDisplay').innerText = appState.user.fullName || appState.user.username;
      document.getElementById('userRoleBadge').innerText = appState.user.role || 'Superadmin';
      
      // Auto-Pull & Sync dari Cloud Bridge saat pertama kali dashboard dibuka
      loadChatLogsBackend(1, true);
      loadBroadcastQueueBackend(1, true);
      loadClientsBackend(true);
      loadBookingsBackend(true);
    }

    function showLoginGateView() {
      document.getElementById('portalDashboardView').style.display = 'none';
      document.getElementById('portalLoginView').style.display = 'block';
      document.getElementById('txtPortalAction').innerText = 'Login Petugas';
    }

    function handlePortalAuthNav() {
      if (appState.user) {
        logoutAdmin();
      } else {
        showLoginGateView();
        document.getElementById('directUsername').focus();
      }
    }

    function submitAdminLoginDirect() {
      const u = document.getElementById('directUsername').value.trim();
      const p = document.getElementById('directPassword').value.trim();
      const btn = document.getElementById('btnDirectLogin');

      if (!u || !p) {
        showToast('Username dan password wajib diisi!', 'warning');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = 'Memverifikasi...';

      runBackend('loginUser', [{ username: u, password: p }], function(res) {
        btn.disabled = false;
        btn.innerHTML = '<iconify-icon icon="solar:lock-keyhole-minimalistic-bold"></iconify-icon> <span>Masuk ke Portal V2</span>';

        if (res && (res.success === true || res.status === 'success') && res.user) {
          appState.user = res.user;
          sessionStorage.setItem('akshara_v2_user', JSON.stringify(res.user));
          document.getElementById('directPassword').value = '';
          showToast('Selamat datang, ' + (res.user.fullName || res.user.username), 'success');
          showDashboardView();
        } else {
          showToast(res.message || 'Username atau password salah!', 'danger');
        }
      }, function(err) {
        btn.disabled = false;
        btn.innerHTML = '<iconify-icon icon="solar:lock-keyhole-minimalistic-bold"></iconify-icon> <span>Masuk ke Portal V2</span>';
        showToast('Koneksi server terputus: ' + err.message, 'danger');
      });
    }

    function logoutAdmin() {
      appState.user = null;
      sessionStorage.removeItem('akshara_v2_user');
      showLoginGateView();
      showToast('Sesi portal telah diakhiri.', 'warning');
    }

    function switchDashboardTab(tabId) {
      const tabs = ['chatLogs', 'broadcast', 'clients', 'templates', 'bookings', 'aiConfig'];
      tabs.forEach(t => {
        const btn = document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1) + 'Btn');
        const content = document.getElementById('tabContent' + t.charAt(0).toUpperCase() + t.slice(1));
        if (btn) btn.classList.remove('active');
        if (content) content.style.display = 'none';
      });

      const activeBtn = document.getElementById('tab' + tabId.charAt(0).toUpperCase() + tabId.slice(1) + 'Btn');
      const activeContent = document.getElementById('tabContent' + tabId.charAt(0).toUpperCase() + tabId.slice(1));
      if (activeBtn) activeBtn.classList.add('active');
      if (activeContent) activeContent.style.display = 'block';

      if (tabId === 'chatLogs') loadChatLogsBackend(1, false);
      if (tabId === 'broadcast') loadBroadcastQueueBackend(1, false);
      if (tabId === 'clients') loadClientsBackend(false);
      if (tabId === 'templates') loadTemplatesBackend(false);
      if (tabId === 'bookings') loadBookingsBackend(false);
      if (tabId === 'aiConfig') loadAiConfigBackend();
    }

    // =========================================================================
    // TAB 1: MONITORING LOG CHAT (UNIVERSAL PARSER + CLOUD BRIDGE)
    // =========================================================================
    function loadChatLogsBackend(page, forceCloud) {
      page = page || 1;
      const search = document.getElementById('filterChatSearch').value;
      const status = document.getElementById('filterChatStatus').value;

      runBackend('getChatLogsPaginated', [{ page, pageSize: 10, search, status, refresh: Boolean(forceCloud) }], function(res) {
        let rawLogs = [];
        if (res) {
          if (Array.isArray(res)) rawLogs = res;
          else if (Array.isArray(res.logs)) rawLogs = res.logs;
          else if (Array.isArray(res.data)) rawLogs = res.data;
          else if (Array.isArray(res.list)) rawLogs = res.list;
        }

        // Jika data dari Express lokal kosong, tarik data langsung ke Google Apps Script
        if (rawLogs.length === 0 && (!search && !status)) {
          fetchDirectFromGAS('getChatLogsPaginated', { page, pageSize: 10, search, status }, function(gasRes) {
            let gasLogs = [];
            if (gasRes) {
              if (Array.isArray(gasRes)) gasLogs = gasRes;
              else if (Array.isArray(gasRes.logs)) gasLogs = gasRes.logs;
              else if (Array.isArray(gasRes.data)) gasLogs = gasRes.data;
              else if (Array.isArray(gasRes.list)) gasLogs = gasRes.list;
            }

            if (gasLogs.length > 0) {
              appState.chatPage = (gasRes && gasRes.page) || 1;
              appState.chatTotalPages = (gasRes && gasRes.totalPages) || 1;
              renderChatTable(gasLogs);
              document.getElementById('txtPaginationInfo').innerText = `Halaman ${appState.chatPage} dari ${appState.chatTotalPages} (${(gasRes && gasRes.totalCount) || gasLogs.length} total log)`;
              document.getElementById('btnPrevPage').disabled = (appState.chatPage <= 1);
              document.getElementById('btnNextPage').disabled = (appState.chatPage >= appState.chatTotalPages);
              return;
            }
            renderChatTable([]);
          });
          return;
        }

        appState.chatPage = (res && res.page) || 1;
        appState.chatTotalPages = (res && res.totalPages) || 1;
        renderChatTable(rawLogs);
        document.getElementById('txtPaginationInfo').innerText = `Halaman ${appState.chatPage} dari ${appState.chatTotalPages} (${(res && res.totalCount) || rawLogs.length} total log)`;
        document.getElementById('btnPrevPage').disabled = (appState.chatPage <= 1);
        document.getElementById('btnNextPage').disabled = (appState.chatPage >= appState.chatTotalPages);
      });
    }

    function renderChatTable(logs) {
      const tbody = document.getElementById('chatLogsTableBody');
      tbody.innerHTML = '';
      if (!logs || logs.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; color:var(--text-muted); padding:28px;">Tidak ada log percakapan.</td></tr>';
        return;
      }

      logs.forEach(l => {
        const isArr = Array.isArray(l);
        const logId = l.logId || l.Log_ID || (isArr ? l[0] : '-');
        const timestamp = l.timestamp || l.Timestamp || (isArr ? l[1] : '-');
        const clientId = l.clientId || l.Client_ID || (isArr ? l[2] : 'CLI-0001');
        const sender = l.sender || l.senderNumber || l.Sender_Number || (isArr ? l[3] : '-');
        const receiver = l.receiver || l.receiverNumber || l.Receiver_Number || (isArr ? l[4] : '-');
        const type = l.type || l.messageType || l.Message_Type || (isArr ? l[5] : 'INCOMING');
        const content = l.content || l.messageContent || l.Message_Content || (isArr ? l[6] : '');
        const status = (l.status || l.Status || (isArr ? l[7] : 'DELIVERED')).toUpperCase();

        const preview = content.length > 40 ? content.substring(0, 40) + '...' : content;
        const dotClass = (status === 'DELIVERED' || status === 'SENT') ? 'status-connected' : 'status-disconnected';

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><span style="font-family:var(--font-mono); font-weight:700; color:var(--cyan-deep);">${logId}</span></td>
          <td style="white-space:nowrap; font-size:0.8rem;">${timestamp}</td>
          <td>${clientId}</td>
          <td>${sender}</td>
          <td>${receiver}</td>
          <td><span style="font-size:0.75rem; padding:2px 6px; border-radius:4px; background:rgba(0,180,216,0.1); color:var(--cyan-deep); font-weight:600;">${type}</span></td>
          <td>${escapeHtml(preview)}</td>
          <td><span class="status-dot ${dotClass}"></span>${status}</td>
          <td><button class="cyber-btn-secondary" style="padding:4px 8px; font-size:0.78rem;" onclick="viewMessageDetail('${logId}', '${encodeURIComponent(content)}', '${timestamp}')">Detail</button></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function viewMessageDetail(logId, enc, time) {
      document.getElementById('msgDetailBody').innerHTML = `<strong>Log ID:</strong> ${logId}<br><strong>Waktu:</strong> ${time}<br><br><strong>Isi Pesan:</strong><br>${escapeHtml(decodeURIComponent(enc))}`;
      openModal('msgDetailModal');
    }

    function debounceChatSearch() {
      clearTimeout(appState.chatDebounceTimer);
      appState.chatDebounceTimer = setTimeout(() => loadChatLogsBackend(1, false), 400);
    }
    function changeChatPage(dir) {
      const target = appState.chatPage + dir;
      if (target >= 1 && target <= appState.chatTotalPages) loadChatLogsBackend(target, false);
    }

    // =========================================================================
    // TAB 2: BROADCAST QUEUE MANAGER (UNIVERSAL PARSER + CLOUD BRIDGE)
    // =========================================================================
    function loadBroadcastQueueBackend(page, forceCloud) {
      page = page || 1;
      const search = document.getElementById('filterQueueSearch').value;
      const status = document.getElementById('filterQueueStatus').value;

      runBackend('getBroadcastQueuePaginated', [{ page, pageSize: 10, search, status, refresh: Boolean(forceCloud) }], function(res) {
        let rawQueue = [];
        if (res) {
          if (Array.isArray(res)) rawQueue = res;
          else if (Array.isArray(res.queue)) rawQueue = res.queue;
          else if (Array.isArray(res.data)) rawQueue = res.data;
          else if (Array.isArray(res.list)) rawQueue = res.list;
        }

        if (rawQueue.length === 0 && (!search && !status)) {
          fetchDirectFromGAS('getBroadcastQueuePaginated', { page, pageSize: 10, search, status }, function(gasRes) {
            let gasQueue = [];
            if (gasRes) {
              if (Array.isArray(gasRes)) gasQueue = gasRes;
              else if (Array.isArray(gasRes.queue)) gasQueue = gasRes.queue;
              else if (Array.isArray(gasRes.data)) gasQueue = gasRes.data;
              else if (Array.isArray(gasRes.list)) gasQueue = gasRes.list;
            }

            if (gasQueue.length > 0) {
              appState.queuePage = (gasRes && gasRes.page) || 1;
              appState.queueTotalPages = (gasRes && gasRes.totalPages) || 1;
              renderBroadcastQueueTable(gasQueue);
              document.getElementById('txtQueuePaginationInfo').innerText = `Halaman ${appState.queuePage} dari ${appState.queueTotalPages} (${(gasRes && gasRes.totalCount) || gasQueue.length} antrean)`;
              document.getElementById('btnQueuePrevPage').disabled = (appState.queuePage <= 1);
              document.getElementById('btnQueueNextPage').disabled = (appState.queuePage >= appState.queueTotalPages);
              return;
            }
            renderBroadcastQueueTable([]);
          });
          return;
        }

        appState.queuePage = (res && res.page) || 1;
        appState.queueTotalPages = (res && res.totalPages) || 1;
        renderBroadcastQueueTable(rawQueue);
        document.getElementById('txtQueuePaginationInfo').innerText = `Halaman ${appState.queuePage} dari ${appState.queueTotalPages} (${(res && res.totalCount) || rawQueue.length} antrean)`;
        document.getElementById('btnQueuePrevPage').disabled = (appState.queuePage <= 1);
        document.getElementById('btnQueueNextPage').disabled = (appState.queuePage >= appState.queueTotalPages);
      });
    }

    function renderBroadcastQueueTable(queue) {
      const tbody = document.getElementById('broadcastQueueTableBody');
      tbody.innerHTML = '';
      if (!queue || queue.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--text-muted); padding:28px;">Tidak ada antrean broadcast.</td></tr>';
        return;
      }

      queue.forEach(q => {
        const isArr = Array.isArray(q);
        const queueId = q.queueId || q.Queue_ID || (isArr ? q[0] : '-');
        const clientId = q.clientId || q.Client_ID || (isArr ? q[1] : 'CLI-0001');
        const targetNumber = q.targetNumber || q.Target_Number || (isArr ? q[2] : '-');
        const messageContent = q.messageContent || q.Message_Content || (isArr ? q[3] : '');
        const scheduledTime = q.scheduledTime || q.Scheduled_Time || (isArr ? q[4] : '-');
        const status = (q.status || q.Status || (isArr ? q[5] : 'PENDING')).toUpperCase();
        const sentAt = q.sentAt || q.Sent_At || (isArr ? q[6] : '-');

        const dot = status === 'SENT' ? 'status-connected' : (status === 'PENDING' ? 'status-scanning' : 'status-disconnected');
        const act = status === 'SENT' ? '<span style="font-size:0.78rem; color:var(--success); font-weight:700;">Terkirim</span>' : `
          <button class="cyber-btn" style="padding:3px 8px; font-size:0.75rem;" onclick="dispatchBroadcastAction('${queueId}')">Kirim</button>
          <button class="cyber-btn-secondary" style="padding:3px 8px; font-size:0.75rem; color:var(--danger);" onclick="deleteBroadcastAction('${queueId}')">Batal</button>
        `;

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><span style="font-family:var(--font-mono); font-weight:700; color:var(--cyan-deep);">${queueId}</span></td>
          <td>${clientId}</td>
          <td>${targetNumber}</td>
          <td>${escapeHtml(messageContent.length > 35 ? messageContent.substring(0, 35) + '...' : messageContent)}</td>
          <td style="white-space:nowrap; font-size:0.8rem;">${scheduledTime}</td>
          <td><span class="status-dot ${dot}"></span>${status}</td>
          <td style="font-size:0.8rem;">${sentAt}</td>
          <td><div style="display:flex; gap:6px;">${act}</div></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function debounceQueueSearch() {
      clearTimeout(appState.queueDebounceTimer);
      appState.queueDebounceTimer = setTimeout(() => loadBroadcastQueueBackend(1, false), 400);
    }
    function changeQueuePage(dir) {
      const target = appState.queuePage + dir;
      if (target >= 1 && target <= appState.queueTotalPages) loadBroadcastQueueBackend(target, false);
    }
    function openAddBroadcastModal() {
      document.getElementById('bcTargetPhone').value = '';
      document.getElementById('bcContent').value = '';
      openModal('broadcastModal');
    }
    function submitAddBroadcast() {
      const clientId = document.getElementById('bcClientId').value;
      const targetNumber = document.getElementById('bcTargetPhone').value.trim();
      const messageContent = document.getElementById('bcContent').value.trim();
      const scheduledTime = document.getElementById('bcScheduledTime').value;

      runBackend('addBroadcastQueueItem', [{ clientId, targetNumber, messageContent, scheduledTime }], function(res) {
        if (res && (res.success || res.status === 'success')) {
          showToast(res.message || 'Pesan berhasil dijadwalkan!', 'success');
          closeModal('broadcastModal');
          loadBroadcastQueueBackend(1, true);
        }
      });
    }
    function dispatchBroadcastAction(queueId) {
      showToast('Mengirim pesan ' + queueId + '...', 'warning');
      runBackend('sendBroadcastNow', [queueId], function(res) {
        if (res && (res.success || res.status === 'success')) {
          showToast(res.message || 'Pesan terkirim!', 'success');
          loadBroadcastQueueBackend(appState.queuePage, true);
          loadChatLogsBackend(1, true);
        }
      });
    }
    function deleteBroadcastAction(queueId) {
      runBackend('deleteBroadcastQueueItem', [queueId], function(res) {
        if (res && (res.success || res.status === 'success')) {
          showToast(res.message || 'Antrean dibatalkan.', 'warning');
          loadBroadcastQueueBackend(appState.queuePage, true);
        }
      });
    }

    // =========================================================================
    // TAB 3: CLIENT RAILWAY BOT (UNIVERSAL PARSER + CLOUD BRIDGE)
    // =========================================================================
    function loadClientsBackend(forceCloud) {
      runBackend('getClientsList', [{ refresh: Boolean(forceCloud) }], function(res) {
        let rawClients = [];
        if (res) {
          if (Array.isArray(res)) rawClients = res;
          else if (Array.isArray(res.clients)) rawClients = res.clients;
          else if (Array.isArray(res.data)) rawClients = res.data;
          else if (Array.isArray(res.list)) rawClients = res.list;
        }

        if (rawClients.length === 0) {
          fetchDirectFromGAS('getClientsList', {}, function(gasRes) {
            let gasClients = [];
            if (gasRes) {
              if (Array.isArray(gasRes)) gasClients = gasRes;
              else if (Array.isArray(gasRes.clients)) gasClients = gasRes.clients;
              else if (Array.isArray(gasRes.data)) gasClients = gasRes.data;
            }

            if (gasClients.length > 0) {
              renderClientsTable(gasClients, gasRes.stats);
              return;
            }
            renderClientsTable(rawClients, res && res.stats);
          });
          return;
        }

        renderClientsTable(rawClients, res && res.stats);
      });
    }

    function renderClientsTable(clients, stats) {
      const tbody = document.getElementById('clientsTableBody');
      tbody.innerHTML = '';

      (clients || []).forEach(c => {
        const isArr = Array.isArray(c);
        const clientId = c.clientId || c.Client_ID || (isArr ? c[0] : 'CLI-0001');
        const name = c.name || c.Client_Name || (isArr ? c[1] : '-');
        const phone = c.phone || c.Phone_Number || (isArr ? c[2] : '-');
        const railwayUrl = c.railwayUrl || c.Railway_Base_URL || (isArr ? c[3] : DEFAULT_RAILWAY_URL);
        const status = (c.status || c.Bot_Status || (isArr ? c[4] : 'CONNECTED')).toUpperCase();
        const expiredDate = c.expiredDate || c.Expired_Date || (isArr ? c[5] : '-');
        const notes = c.notes || c.Notes || (isArr ? c[6] : '');

        const dot = status === 'CONNECTED' ? 'status-connected' : (status === 'SCANNING' ? 'status-scanning' : 'status-disconnected');
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><span style="font-family:var(--font-mono); font-weight:700; color:var(--cyan-deep);">${clientId}</span></td>
          <td><strong>${escapeHtml(name)}</strong></td>
          <td>${phone}</td>
          <td><a href="${railwayUrl}" target="_blank" style="color:var(--cyan-deep); font-size:0.8rem;">${railwayUrl}</a></td>
          <td><span class="status-dot ${dot}"></span>${status}</td>
          <td style="font-size:0.8rem;">${expiredDate}</td>
          <td><button class="cyber-btn-secondary" style="padding:4px 8px; font-size:0.76rem;" onclick="pingClientAction('${railwayUrl}', this)">Ping</button></td>
          <td>
            <button class="cyber-btn" style="padding:4px 8px; font-size:0.76rem;" onclick="openQrModal('${clientId}', '${railwayUrl}')">Scan QR</button>
            <button class="cyber-btn-secondary" style="padding:4px 8px; font-size:0.76rem; color:var(--danger);" onclick="deleteClientAction('${clientId}')">Hapus</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      if (stats) {
        document.getElementById('statTotalClients').innerText = stats.total || clients.length;
        document.getElementById('statConnectedClients').innerText = stats.connected || 0;
        document.getElementById('statScanningClients').innerText = stats.scanning || 0;
        document.getElementById('statDisconnectedClients').innerText = stats.disconnected || 0;
      }
    }

    function pingClientAction(url, btn) {
      btn.innerText = 'Ping...';
      runBackend('pingRailwayClient', [{ railwayUrl: url }], function(res) {
        btn.innerText = 'Ping';
        showToast(res.message || 'Ping selesai', res.success ? 'success' : 'danger');
      });
    }
    function openAddClientModal() {
      document.getElementById('modalClientId').value = '';
      document.getElementById('clName').value = '';
      document.getElementById('clPhone').value = '';
      document.getElementById('clRailwayUrl').value = DEFAULT_RAILWAY_URL;
      document.getElementById('clNotes').value = '';
      openModal('clientModal');
    }
    function submitClientForm() {
      const payload = {
        clientId: document.getElementById('modalClientId').value,
        name: document.getElementById('clName').value.trim(),
        phone: document.getElementById('clPhone').value.trim(),
        railwayUrl: document.getElementById('clRailwayUrl').value.trim() || DEFAULT_RAILWAY_URL,
        status: document.getElementById('clStatus').value,
        notes: document.getElementById('clNotes').value.trim()
      };
      runBackend('saveOrUpdateClient', [payload], function(res) {
        if (res && (res.success || res.status === 'success')) {
          showToast(res.message || 'Client disimpan.', 'success');
          closeModal('clientModal');
          loadClientsBackend(true);
        }
      });
    }
    function deleteClientAction(clientId) {
      runBackend('deleteClient', [clientId], function(res) {
        if (res && (res.success || res.status === 'success')) {
          showToast(res.message || 'Client dihapus.', 'warning');
          loadClientsBackend(true);
        }
      });
    }

    // QR BAILEYS
    function openQrModal(clientId, railwayUrl) {
      const target = (railwayUrl || DEFAULT_RAILWAY_URL).replace(/\/$/, '');
      const qrImg = document.getElementById('qrImageElement');
      const loader = document.getElementById('qrLoaderBox');
      const overlay = document.getElementById('qrSuccessOverlay');
      qrImg.style.display = 'none';
      overlay.style.display = 'none';
      loader.style.display = 'flex';
      openModal('qrModal');

      if (appState.activeQrSocket) {
        try { appState.activeQrSocket.disconnect(); } catch (e) {}
      }
      if (typeof io !== 'undefined') {
        try {
          appState.activeQrSocket = io(target, { transports: ['websocket', 'polling'], timeout: 6000 });
          appState.activeQrSocket.on('qr', function(data) {
            const qrSrc = (typeof data === 'object' && data.qrDataUrl) ? data.qrDataUrl : (typeof data === 'string' ? data : '');
            if (qrSrc) {
              loader.style.display = 'none';
              qrImg.src = qrSrc;
              qrImg.style.display = 'block';
            }
          });
          appState.activeQrSocket.on('ready', () => {
            loader.style.display = 'none';
            qrImg.style.display = 'none';
            overlay.style.display = 'flex';
            setTimeout(() => closeModal('qrModal'), 2000);
          });
        } catch (e) {}
      }
    }
    function triggerResetRailwaySession() {
      fetch(DEFAULT_RAILWAY_URL + '/api/reset-session', { method: 'POST' })
        .then(() => showToast('Permintaan reset sesi dikirim ke Railway.', 'warning'))
        .catch(() => showToast('Reset sesi terkirim.', 'warning'));
    }

    // =========================================================================
    // TAB 4: TEMPLATES (UNIVERSAL PARSER + CLOUD BRIDGE)
    // =========================================================================
    function loadTemplatesBackend(forceCloud) {
      runBackend('getTemplatesList', [{ refresh: Boolean(forceCloud) }], function(res) {
        let rawTemplates = [];
        if (res) {
          if (Array.isArray(res)) rawTemplates = res;
          else if (Array.isArray(res.templates)) rawTemplates = res.templates;
          else if (Array.isArray(res.data)) rawTemplates = res.data;
          else if (Array.isArray(res.list)) rawTemplates = res.list;
        }

        if (rawTemplates.length === 0) {
          fetchDirectFromGAS('getTemplatesList', {}, function(gasRes) {
            let gasTemplates = [];
            if (gasRes) {
              if (Array.isArray(gasRes)) gasTemplates = gasRes;
              else if (Array.isArray(gasRes.templates)) gasTemplates = gasRes.templates;
              else if (Array.isArray(gasRes.data)) gasTemplates = gasRes.data;
            }

            if (gasTemplates.length > 0) {
              renderTemplatesList(gasTemplates);
              return;
            }
            renderTemplatesList([]);
          });
          return;
        }
        renderTemplatesList(rawTemplates);
      });
    }

    function renderTemplatesList(templates) {
      const container = document.getElementById('templatesListContainer');
      container.innerHTML = '';
      if (!templates || templates.length === 0) {
        container.innerHTML = '<div style="color:var(--text-muted); padding:16px;">Belum ada template terdaftar.</div>';
        return;
      }
      templates.forEach(t => {
        const isArr = Array.isArray(t);
        const name = t.name || t.Template_Name || (isArr ? t[1] : '-');
        const category = t.category || t.Category || (isArr ? t[2] : 'UMUM');
        const content = t.content || t.Content || (isArr ? t[3] : '');

        const div = document.createElement('div');
        div.className = 'glass-panel';
        div.style.padding = '16px';
        div.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:6px;">
            <div>
              <span style="font-size:0.7rem; font-weight:700; color:var(--cyan-deep); text-transform:uppercase;">${category}</span>
              <h4 style="font-size:0.95rem; color:var(--text-main);">${escapeHtml(name)}</h4>
            </div>
            <button class="cyber-btn-secondary" style="padding:4px 8px;" onclick="copyText('${encodeURIComponent(content)}')"><iconify-icon icon="solar:copy-bold"></iconify-icon></button>
          </div>
          <p style="font-size:0.82rem; color:var(--text-muted); background:rgba(0,180,216,0.05); padding:8px; border-radius:8px; font-family:monospace; border:1px solid rgba(0,180,216,0.2);">${escapeHtml(content)}</p>
        `;
        container.appendChild(div);
      });
    }
    function copyText(enc) {
      navigator.clipboard.writeText(decodeURIComponent(enc)).then(() => showToast('Template disalin!', 'success'));
    }

    // =========================================================================
    // TAB 5: ANTREAN & RESERVASI PASIEN (UNIVERSAL PARSER + CLOUD BRIDGE)
    // =========================================================================
    function loadBookingsBackend(forceCloud) {
      runBackend('getBookingsList', [{ refresh: Boolean(forceCloud) }], function(res) {
        let rawBookings = [];
        if (res) {
          if (Array.isArray(res)) rawBookings = res;
          else if (Array.isArray(res.bookings)) rawBookings = res.bookings;
          else if (Array.isArray(res.data)) rawBookings = res.data;
          else if (Array.isArray(res.list)) rawBookings = res.list;
        }

        if (rawBookings.length === 0) {
          fetchDirectFromGAS('getBookingsList', {}, function(gasRes) {
            let gasBookings = [];
            if (gasRes) {
              if (Array.isArray(gasRes)) gasBookings = gasRes;
              else if (Array.isArray(gasRes.bookings)) gasBookings = gasRes.bookings;
              else if (Array.isArray(gasRes.data)) gasBookings = gasRes.data;
            }

            if (gasBookings.length > 0) {
              renderBookingsTable(gasBookings);
              return;
            }
            renderBookingsTable([]);
          });
          return;
        }
        renderBookingsTable(rawBookings);
      });
    }

    function renderBookingsTable(bookings) {
      const tbody = document.getElementById('bookingsTableBody');
      tbody.innerHTML = '';
      if (!bookings || bookings.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted); padding:30px;">Belum ada pendaftaran pasien masuk.</td></tr>';
        return;
      }
      bookings.forEach(b => {
        const isArr = Array.isArray(b);
        const bookingId = b.bookingId || b.kodeAntrean || b.Booking_ID || (isArr ? b[0] : '-');
        const patientName = b.patientName || b.namaPasien || b.Nama_Pasien || (isArr ? b[1] : '-');
        const phoneNumber = b.phoneNumber || b.noHp || b.Phone_Number || (isArr ? b[2] : '-');
        const serviceType = b.serviceType || b.ruanganPoli || b.Service_Type || (isArr ? b[3] : 'Pemeriksaan Gigi');
        const bookingDate = b.bookingDate || b.waktuDaftar || b.Booking_Date || (isArr ? b[4] : '-');
        const status = b.status || b.statusAntrean || b.Status || (isArr ? b[5] : 'Menunggu');
        const createdAt = b.createdAt || b.waktuDaftar || b.Created_At || (isArr ? b[6] : '-');

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><span style="font-family:var(--font-mono); font-weight:700; color:var(--cyan-deep);">${bookingId}</span></td>
          <td><strong>${escapeHtml(patientName)}</strong></td>
          <td>${phoneNumber}</td>
          <td>${serviceType}</td>
          <td>${bookingDate}</td>
          <td><span style="padding:2px 8px; border-radius:4px; font-size:0.74rem; background:rgba(16,185,129,0.15); color:var(--success); font-weight:700;">${status}</span></td>
          <td style="font-size:0.8rem;">${createdAt}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // =========================================================================
    // TAB 6: AI CONFIGURATION
    // =========================================================================
    function loadAiModelCatalog() {
      runBackend('getAvailableAiModels', [], function(res) {
        if (res && (res.success || res.status === 'success') && res.models) {
          appState.availableModels = res.models;
          appState.selectedModel = res.defaultModel || 'gemini-3.5-flash';

          const chatSelect = document.getElementById('chatModelSelector');
          const cfgSelect = document.getElementById('cfgDefaultAiModel');

          const categories = {};
          res.models.forEach(m => {
            if (!categories[m.category]) categories[m.category] = [];
            categories[m.category].push(m);
          });

          let html = '';
          for (const cat in categories) {
            html += `<optgroup label="${cat}">`;
            categories[cat].forEach(item => {
              const isSel = (item.id === appState.selectedModel) ? ' selected' : '';
              html += `<option value="${item.id}"${isSel}>${item.name} - ${item.description}</option>`;
            });
            html += `</optgroup>`;
          }

          if (chatSelect) chatSelect.innerHTML = html;
          if (cfgSelect) cfgSelect.innerHTML = html;
          loadAiConfigBackend();
        }
      });
    }

    function onChatModelChange() {
      appState.selectedModel = document.getElementById('chatModelSelector').value;
      showToast('Model beralih ke: ' + appState.selectedModel, 'success');
    }

    function saveCurrentChatModelAsDefault() {
      const chosen = document.getElementById('chatModelSelector').value;
      showToast('Menyimpan ' + chosen + ' sebagai default...', 'warning');
      runBackend('setClinicModelQuick', [chosen], function(res) {
        if (res && (res.success || res.status === 'success')) {
          showToast(res.message || 'Model default tersimpan!', 'success');
          appState.selectedModel = chosen;
          if (document.getElementById('cfgDefaultAiModel')) {
            document.getElementById('cfgDefaultAiModel').value = chosen;
          }
        }
      });
    }

    function loadAiConfigBackend() {
      runBackend('getAiConfig', [], function(res) {
        if (res && (res.success || res.status === 'success')) {
          if (document.getElementById('cfgDefaultAiModel') && res.currentModel) {
            document.getElementById('cfgDefaultAiModel').value = res.currentModel;
          }
          if (document.getElementById('cfgOpenAiModel') && res.openAiModel) {
            document.getElementById('cfgOpenAiModel').value = res.openAiModel;
          }
          if (document.getElementById('chatModelSelector') && res.currentModel) {
            document.getElementById('chatModelSelector').value = res.currentModel;
            appState.selectedModel = res.currentModel;
          }

          const statusEl = document.getElementById('cfgApiKeyStatus');
          if (statusEl) {
            if (res.isConfigured || res.isGeminiConfigured) {
              statusEl.innerHTML = `<span style="color:var(--success); font-weight:700;">● Terkonfigurasi Aktif</span> (${res.maskedApiKey || res.maskedGeminiKey})`;
            } else {
              statusEl.innerHTML = `<span style="color:var(--danger); font-weight:700;">● Belum Dikonfigurasi</span> (Masukkan API Key Google AI Studio)`;
            }
          }

          const statusOpenAiEl = document.getElementById('cfgOpenAiKeyStatus');
          if (statusOpenAiEl) {
            if (res.isOpenAiConfigured) {
              statusOpenAiEl.innerHTML = `<span style="color:var(--success); font-weight:700;">● Terkonfigurasi Aktif</span> (${res.maskedOpenAiKey})`;
            } else {
              statusOpenAiEl.innerHTML = `<span style="color:var(--danger); font-weight:700;">● Belum Dikonfigurasi</span>`;
            }
          }
        }
      });
    }

    function saveAiConfigAction() {
      const model = document.getElementById('cfgDefaultAiModel').value;
      const apiKey = document.getElementById('cfgApiKeyInput').value.trim();
      const openaiModel = document.getElementById('cfgOpenAiModel').value;
      const openaiApiKey = document.getElementById('cfgOpenAiKeyInput').value.trim();

      showToast('Menyimpan konfigurasi AI...', 'warning');

      runBackend('saveAiConfig', [{ model, apiKey, openaiModel, openaiApiKey }], function(res) {
        if (res && (res.success || res.status === 'success')) {
          showToast(res.message || 'Konfigurasi AI berhasil disimpan!', 'success');
          document.getElementById('cfgApiKeyInput').value = '';
          document.getElementById('cfgOpenAiKeyInput').value = '';
          appState.selectedModel = model;
          loadAiConfigBackend();
        }
      });
    }

    function testAiConnectionAction(type) {
      if (type === 'openai') {
        const model = document.getElementById('cfgOpenAiModel').value;
        showToast('Menguji OpenAI ' + model + '...', 'warning');
        runBackend('askOpenAiClinic', [{ prompt: 'Ping test klinis Estaka Dental Clinic.', model }], function(res) {
          showToast('Koneksi OpenAI Sukses (' + (res.modelUsed || model) + ')!', res.success ? 'success' : 'danger');
        });
      } else {
        const model = document.getElementById('cfgDefaultAiModel').value || 'gemini-3.5-flash';
        showToast('Menguji respon Google Gemini ' + model + '...', 'warning');
        runBackend('askGeminiClinic', [{ prompt: 'Ping test telemetri Estaka Dental Clinic.', model }], function(res) {
          showToast('Koneksi Gemini Sukses (' + (res.modelUsed || model) + ')!', res.success ? 'success' : 'danger');
        });
      }
    }

    function toggleKeyMask(inputId, btn) {
      const input = document.getElementById(inputId);
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerHTML = '<iconify-icon icon="solar:eye-closed-bold"></iconify-icon>';
      } else {
        input.type = 'password';
        btn.innerHTML = '<iconify-icon icon="solar:eye-bold"></iconify-icon>';
      }
    }

    // FLOATING AI CHATBOX
    function toggleAIChat(force) {
      const box = document.getElementById('aiChatBox');
      box.style.display = (typeof force === 'boolean') ? (force ? 'flex' : 'none') : (box.style.display === 'flex' ? 'none' : 'flex');
    }

    function sendAiMessage() {
      const input = document.getElementById('aiUserInput');
      const prompt = input.value.trim();
      if (!prompt) return;

      const chosen = appState.selectedModel || 'gemini-3.5-flash';
      input.value = '';
      appendBubble('user', prompt);

      const loadId = 'aiLoad_' + Date.now();
      appendBubble('model', `<i>Menghubungkan ke ${chosen}...</i>`, loadId);

      const action = chosen.includes('gpt') || chosen.includes('o3') ? 'askOpenAiClinic' : 'askGeminiClinic';

      runBackend(action, [{ prompt, model: chosen, history: appState.aiHistory }], function(res) {
        const el = document.getElementById(loadId);
        if (el) el.remove();

        if (res && (res.success || res.status === 'success')) {
          const reply = res.reply || res.text;
          appendBubble('model', `<span class="ai-model-tag">${res.modelUsed || chosen}</span><br>${escapeHtml(reply).replace(/\n/g, '<br>')}`);
          appState.aiHistory.push({ role: 'user', text: prompt });
          appState.aiHistory.push({ role: 'model', text: reply });
        } else {
          appendBubble('model', `<span class="ai-model-tag" style="color:var(--danger);">${chosen} Error</span><br>⚠️ ${escapeHtml(res.message || 'Gagal memuat respon')}`);
        }
      });
    }

    function appendBubble(role, html, id) {
      const container = document.getElementById('aiChatMessages');
      const div = document.createElement('div');
      div.className = `ai-bubble ${role === 'user' ? 'bubble-user' : 'bubble-model'}`;
      if (id) div.id = id;
      div.innerHTML = html;
      container.appendChild(div);
      container.scrollTop = container.scrollHeight;
    }

    function exportDataAction(sheetName) {
      showToast('Menyiapkan CSV ' + sheetName + '...', 'warning');
      runBackend('exportDataCSV', [{ sheetName }], function(res) {
        if (res && (res.success || res.status === 'success')) {
          const blob = new Blob([res.csvData], { type: 'text/csv;charset=utf-8;' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = res.fileName;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          showToast('CSV berhasil diunduh.', 'success');
        }
      });
    }

    function openModal(id) { document.getElementById(id).style.display = 'flex'; }
    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    function showToast(msg, type) {
      const box = document.getElementById('toastContainer');
      const item = document.createElement('div');
      item.className = 'toast-item';
      const color = type === 'danger' ? 'var(--danger)' : (type === 'warning' ? 'var(--warning)' : 'var(--cyan-deep)');
      item.style.borderLeftColor = color;
      item.innerHTML = `<iconify-icon icon="solar:info-circle-bold" style="font-size:20px; color:${color};"></iconify-icon><span>${escapeHtml(msg)}</span>`;
      box.appendChild(item);
      setTimeout(() => { if (item.parentNode) item.remove(); }, 4000);
    }
    function escapeHtml(s) {
      return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  </script>
</body>
</html>
