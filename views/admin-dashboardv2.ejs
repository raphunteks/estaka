        <h3 style="font-size: 1.2rem; color: var(--cyan-deep); display: flex; align-items: center; gap: 8px;">
          <iconify-icon icon="solar:qr-code-bold-duotone" style="font-size: 24px; color: var(--cyan-soft);"></iconify-icon>
