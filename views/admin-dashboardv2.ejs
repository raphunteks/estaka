<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title><%= (typeof seo !== 'undefined' && seo.title) ? seo.title : 'Portal V2 & Railway WA Bot Gateway — Estaka Dental Clinic' %></title>
  <meta name="description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Pusat kendali bot WhatsApp multi-client Railway Baileys, monitoring antrean pesan, dan generative AI medis terpadu.' %>">
  <meta name="robots" content="noindex, nofollow">

  <!-- Favicon & Touch Icons -->
  <link rel="icon" type="image/png" href="/img/axalogo.png">
  <link rel="shortcut icon" href="/img/axalogo.png">
  <link rel="apple-touch-icon" href="/img/axalogo.png">
  <meta name="theme-color" content="#f0f7fa">

  <!-- Inline Dynamic PWA Manifest via Data URI -->
  <link rel="manifest" href="data:application/manifest+json,%7B%22name%22%3A%22Estaka%20Dental%20Clinic%20Portal%22%2C%22short_name%22%3A%22EstakaPortal%22%2C%22start_url%22%3A%22%2Fadmin-dashboardv2%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23f0f7fa%22%2C%22theme_color%22%3A%22%2300b4d8%22%2C%22icons%22%3A%5B%7B%22src%22%3A%22%2Fimg%2Faxalogo.png%22%2C%22sizes%22%3A%22192x192%22%2C%22type%22%3A%22image%2Fpng%22%7D%5D%7D">

  <!-- External Typography & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="https://code.iconify.design/iconify-icon/1.0.8/iconify-icon.min.js"></script>

  <!-- Socket.IO Client Engine untuk Real-Time Streaming QR & Pairing Status dari Railway Baileys -->
  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>

  <style>
    :root {
      --bg-base: #f0f7fa;
      --bg-gradient: linear-gradient(135deg, #f0f7fa 0%, #e0f2fe 50%, #f8fafc 100%);
      --bg-card: rgba(255, 255, 255, 0.92);
      --bg-card-hover: rgba(255, 255, 255, 0.98);
      --cyan-soft: #00b4d8;
      --cyan-deep: #0077b6;
      --cyan-aqua: #48cae4;
      --cyan-glow: rgba(0, 180, 216, 0.25);
      --text-main: #0f172a;
      --text-muted: #475569;
      --border-glass: rgba(255, 255, 255, 0.95);
      --border-subtle: rgba(0, 180, 216, 0.22);
      --card-shadow: 0 10px 30px rgba(0, 119, 182, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --info: #0284c7;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: var(--bg-gradient);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.5;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(240, 247, 250, 0.7); }
    ::-webkit-scrollbar-thumb { background: rgba(0, 180, 216, 0.4); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--cyan-deep); }

    .glass-panel {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 16px;
      box-shadow: var(--card-shadow);
      transition: box-shadow 0.25s ease, transform 0.25s ease;
    }

    .glass-panel:hover {
      box-shadow: 0 14px 36px rgba(0, 119, 182, 0.12);
    }

    .cyber-btn {
      background: linear-gradient(135deg, var(--cyan-soft), var(--cyan-deep));
      color: #ffffff !important;
      border: 1px solid transparent;
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.25s ease;
      text-decoration: none !important;
      box-shadow: 0 4px 14px var(--cyan-glow);
      white-space: nowrap;
    }

    .cyber-btn:hover {
      background: linear-gradient(135deg, #0096c7, #023e8a);
      box-shadow: 0 6px 20px rgba(0, 119, 182, 0.35);
      transform: translateY(-1px);
    }

    .cyber-btn-secondary {
      background: #ffffff;
      color: var(--cyan-deep) !important;
      border: 1px solid var(--border-subtle);
      padding: 9px 16px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none !important;
      white-space: nowrap;
    }

    .cyber-btn-secondary:hover {
      background: #f0f9ff;
      border-color: var(--cyan-soft);
      box-shadow: 0 4px 12px rgba(0, 180, 216, 0.15);
    }

    .cyber-input {
      width: 100%;
      background: #ffffff;
      border: 1px solid rgba(0, 180, 216, 0.35);
      padding: 11px 14px;
      border-radius: 10px;
      color: var(--text-main);
      font-size: 0.9rem;
      font-family: inherit;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
    }

    .cyber-input:focus {
      border-color: var(--cyan-deep);
      box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.2);
    }

    /* Top Navigation Bar */
    .top-navbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(0, 180, 216, 0.18);
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      box-shadow: 0 2px 12px rgba(0, 119, 182, 0.05);
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--cyan-deep);
      text-decoration: none;
      white-space: nowrap;
    }

    .brand-logo .dot { color: var(--cyan-soft); }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Dashboard Layout */
    .portal-view {
      max-width: 1400px;
      margin: 20px auto 40px;
      padding: 0 20px;
    }

    .portal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 24px;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 14px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 20px;
    }

    .stat-card {
      padding: 18px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .stat-icon-wrap {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: rgba(0, 180, 216, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: var(--cyan-deep);
      flex-shrink: 0;
    }

    /* Tabs Navigation with Horizontal Scroll for Mobile */
    .tabs-nav {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      overflow-x: auto;
      padding-bottom: 6px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .tabs-nav::-webkit-scrollbar { display: none; }

    .tab-btn {
      background: #ffffff;
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .tab-btn:hover {
      background: rgba(0, 180, 216, 0.08);
      color: var(--cyan-deep);
      border-color: var(--cyan-soft);
    }

    .tab-btn.active {
      background: linear-gradient(135deg, var(--cyan-soft), var(--cyan-deep));
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 14px var(--cyan-glow);
    }

    /* Tables */
    .table-responsive {
      overflow-x: auto;
      margin-top: 16px;
      border-radius: 12px;
      border: 1px solid rgba(0, 180, 216, 0.18);
      -webkit-overflow-scrolling: touch;
    }

    .cyber-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
      text-align: left;
    }

    .cyber-table th {
      padding: 12px 16px;
      background: rgba(0, 119, 182, 0.06);
      color: var(--cyan-deep);
      font-weight: 700;
      border-bottom: 1px solid var(--border-subtle);
      white-space: nowrap;
    }

    .cyber-table td {
      padding: 12px 16px;
      border-bottom: 1px solid rgba(0, 180, 216, 0.1);
      color: var(--text-main);
      vertical-align: middle;
    }

    .cyber-table tr:hover td {
      background: rgba(0, 180, 216, 0.03);
    }

    /* Status Dots */
    .status-dot {
      display: inline-block;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
    }
    .status-connected { background: var(--success); box-shadow: 0 0 8px rgba(16, 185, 129, 0.5); }
    .status-scanning { background: var(--warning); box-shadow: 0 0 8px rgba(245, 158, 11, 0.5); }
    .status-disconnected { background: var(--danger); box-shadow: 0 0 8px rgba(239, 68, 68, 0.5); }

    /* Modals */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.48);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      padding: 16px;
    }

    .modal-content {
      width: 100%;
      max-width: 540px;
      max-height: 90vh;
      overflow-y: auto;
      padding: 24px;
      background: #ffffff;
      border-radius: 16px;
    }

    /* Floating Actions */
    .floating-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      z-index: 1001;
    }

    .float-circle-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(0, 119, 182, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.85);
      text-decoration: none;
      transition: transform 0.2s ease;
    }

    .float-circle-btn:hover { transform: scale(1.08); }
    .btn-ai-float { background: linear-gradient(135deg, var(--cyan-soft), var(--cyan-deep)); color: #ffffff; }
    .btn-wa-float { background: #25d366; color: #ffffff; }

    .ai-chat-box {
      position: fixed;
      bottom: 88px;
      right: 24px;
      width: 420px;
      max-width: calc(100vw - 32px);
      height: 560px;
      display: none;
      flex-direction: column;
      z-index: 1002;
      box-shadow: 0 16px 40px rgba(0, 119, 182, 0.22);
      border-radius: 16px;
      overflow: hidden;
      background: #ffffff;
      border: 1px solid var(--border-subtle);
    }

    .ai-chat-header {
      padding: 12px 16px;
      border-bottom: 1px solid rgba(0, 180, 216, 0.2);
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: #ffffff;
    }

    .ai-chat-body {
      flex: 1;
      padding: 16px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      font-size: 0.88rem;
      background: rgba(240, 247, 250, 0.5);
    }

    .ai-bubble {
      max-width: 85%;
      padding: 10px 14px;
      border-radius: 14px;
      line-height: 1.45;
      word-wrap: break-word;
    }

    .bubble-user {
      align-self: flex-end;
      background: linear-gradient(135deg, var(--cyan-soft), var(--cyan-deep));
      color: #ffffff;
      border-bottom-right-radius: 2px;
    }

    .bubble-model {
      align-self: flex-start;
      background: #ffffff;
      border: 1px solid rgba(0, 180, 216, 0.25);
      color: var(--text-main);
      border-bottom-left-radius: 2px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .ai-model-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-family: var(--font-mono);
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(0, 180, 216, 0.12);
      color: var(--cyan-deep);
      font-weight: 700;
      margin-bottom: 4px;
    }

    .ai-chat-footer {
      padding: 12px;
      border-top: 1px solid rgba(0, 180, 216, 0.2);
      background: #ffffff;
      display: flex;
      gap: 8px;
    }

    /* Toast Container */
    .toast-container {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 3000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast-item {
      background: #ffffff;
      border-left: 4px solid var(--cyan-deep);
      padding: 12px 18px;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0, 119, 182, 0.15);
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      gap: 10px;
      animation: fadeInRight 0.3s ease forwards;
      pointer-events: auto;
    }

    @keyframes fadeInRight {
      from { opacity: 0; transform: translateX(30px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* Responsive Breakpoints */
    @media (max-width: 1024px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .portal-view { padding: 0 16px; margin-top: 16px; }
    }

    @media (max-width: 768px) {
      .top-navbar { padding: 10px 16px; flex-wrap: wrap; }
      .brand-logo { font-size: 1.1rem; }
      .stats-grid { grid-template-columns: 1fr; }
      .portal-header { flex-direction: column; align-items: flex-start; }
      .ai-chat-box { width: calc(100vw - 24px); right: 12px; bottom: 80px; height: 500px; }
      .floating-container { bottom: 16px; right: 16px; }
    }
  </style>
</head>
<body>

  <!-- Top Navigation Bar -->
  <header class="top-navbar" role="banner">
    <a href="/" class="brand-logo">
      <iconify-icon icon="solar:health-bold-duotone" style="font-size: 26px; color: var(--cyan-soft);"></iconify-icon>
      <span>ESTAKA DENTAL<span class="dot">.</span>V2</span>
    </a>

    <div class="header-actions">
      <a href="https://estakadental.com" target="_blank" class="cyber-btn-secondary" style="padding: 7px 12px; font-size: 0.82rem;" title="Buka Website Utama">
        <iconify-icon icon="solar:global-bold"></iconify-icon>
        <span>Web Utama</span>
      </a>

      <a href="/admin-dashboard" class="cyber-btn-secondary" style="padding: 7px 12px; font-size: 0.82rem;" title="Buka Portal Medis V1">
        <iconify-icon icon="solar:stethoscope-bold"></iconify-icon>
        <span>Portal Medis V1</span>
      </a>

      <a href="/antrean-tv" target="_blank" class="cyber-btn-secondary" style="padding: 7px 12px; font-size: 0.82rem;" title="Buka Monitor TV Antrean">
        <iconify-icon icon="solar:tv-bold"></iconify-icon>
        <span>TV Antrean</span>
      </a>

      <button id="btnPortalToggle" class="cyber-btn" onclick="handlePortalAuthNav()" style="padding: 7px 14px; font-size: 0.82rem;">
        <iconify-icon icon="solar:shield-keyhole-bold-duotone"></iconify-icon>
        <span id="txtPortalAction">Login Petugas</span>
      </button>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- 1. STANDALONE LOGIN GATE VIEW                                         -->
  <!-- ===================================================================== -->
  <main id="portalLoginView" style="max-width: 440px; margin: 60px auto; padding: 0 20px;">
    <div class="glass-panel" style="padding: 32px 28px; text-align: center;">
      <div style="width: 58px; height: 58px; border-radius: 16px; background: rgba(0, 180, 216, 0.15); color: var(--cyan-deep); display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 16px;">
        <iconify-icon icon="solar:shield-keyhole-bold-duotone"></iconify-icon>
      </div>
      <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--cyan-deep); margin-bottom: 6px;">Portal Medis & WA Bot V2</h2>
      <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 24px;">
        Silakan masuk dengan kredensial petugas Estaka Dental Clinic.
      </p>

      <form onsubmit="event.preventDefault(); submitAdminLoginDirect();" style="text-align: left;">
        <div style="margin-bottom: 16px;">
          <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Username</label>
          <input type="text" id="directUsername" class="cyber-input" placeholder="superadmin / admin / operator1" required>
        </div>
        <div style="margin-bottom: 22px;">
          <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Password</label>
          <input type="password" id="directPassword" class="cyber-input" placeholder="••••••••" required>
        </div>
        <button type="submit" id="btnDirectLogin" class="cyber-btn" style="width: 100%; justify-content: center; padding: 12px; font-size: 0.92rem;">
          <iconify-icon icon="solar:lock-keyhole-minimalistic-bold"></iconify-icon>
          <span>Masuk ke Portal V2</span>
        </button>
      </form>
    </div>
  </main>

  <!-- ===================================================================== -->
  <!-- 2. PORTAL DASHBOARD V2                                                -->
  <!-- ===================================================================== -->
  <main id="portalDashboardView" class="portal-view" style="display: none;">
    <div class="glass-panel portal-header">
      <div>
        <div style="font-size: 0.78rem; color: var(--cyan-deep); font-weight: 800; letter-spacing: 0.8px;">PORTAL MONITORING KLINIS & BOT V2</div>
        <h1 id="dashWelcomeText" style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin-top: 2px;">Pusat Kendali Bot WhatsApp & Railway</h1>
      </div>
      <div style="display: flex; align-items: center; gap: 14px;">
        <div style="text-align: right;">
          <div id="userRoleBadge" style="font-size: 0.74rem; background: rgba(0, 180, 216, 0.15); border: 1px solid var(--cyan-soft); color: var(--cyan-deep); padding: 2px 10px; border-radius: 20px; display: inline-block; font-weight: 700;">
            Superadmin
          </div>
          <div id="userNameDisplay" style="font-size: 0.86rem; font-weight: 700; margin-top: 2px;">Super Administrator Estaka</div>
        </div>
        <button class="cyber-btn-secondary" onclick="logoutAdmin()" title="Keluar dari Portal" style="padding: 8px 12px;">
          <iconify-icon icon="solar:logout-2-bold" style="font-size: 18px; color: var(--danger);"></iconify-icon>
          <span>Keluar</span>
        </button>
      </div>
    </div>

    <!-- Statistics Grid -->
    <div class="stats-grid">
      <div class="glass-panel stat-card">
        <div class="stat-icon-wrap"><iconify-icon icon="solar:server-bold"></iconify-icon></div>
        <div>
          <div style="font-size: 0.76rem; color: var(--text-muted); font-weight: 600;">Total Client Node</div>
          <div id="statTotalClients" style="font-size: 1.45rem; font-weight: 800; color: var(--text-main);">0</div>
        </div>
      </div>
      <div class="glass-panel stat-card">
        <div class="stat-icon-wrap" style="background: rgba(16, 185, 129, 0.15); color: var(--success);"><iconify-icon icon="solar:check-circle-bold"></iconify-icon></div>
        <div>
          <div style="font-size: 0.76rem; color: var(--text-muted); font-weight: 600;">Connected (Aktif)</div>
          <div id="statConnectedClients" style="font-size: 1.45rem; font-weight: 800; color: var(--success);">0</div>
        </div>
      </div>
      <div class="glass-panel stat-card">
        <div class="stat-icon-wrap" style="background: rgba(245, 158, 11, 0.15); color: var(--warning);"><iconify-icon icon="solar:qr-code-bold"></iconify-icon></div>
        <div>
          <div style="font-size: 0.76rem; color: var(--text-muted); font-weight: 600;">Scanning QR</div>
          <div id="statScanningClients" style="font-size: 1.45rem; font-weight: 800; color: var(--warning);">0</div>
        </div>
      </div>
      <div class="glass-panel stat-card">
        <div class="stat-icon-wrap" style="background: rgba(239, 68, 68, 0.15); color: var(--danger);"><iconify-icon icon="solar:close-circle-bold"></iconify-icon></div>
        <div>
          <div style="font-size: 0.76rem; color: var(--text-muted); font-weight: 600;">Disconnected</div>
          <div id="statDisconnectedClients" style="font-size: 1.45rem; font-weight: 800; color: var(--danger);">0</div>
        </div>
      </div>
    </div>

    <!-- 6 Tab Navigation System -->
    <div class="tabs-nav" role="tablist">
      <button class="tab-btn active" id="tabLogsBtn" onclick="switchDashboardTab('chatLogs')">
        <iconify-icon icon="solar:chat-line-bold"></iconify-icon>
        Monitoring Log Chat
      </button>
      <button class="tab-btn" id="tabBroadcastBtn" onclick="switchDashboardTab('broadcast')">
