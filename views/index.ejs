    function switchReservasiTab(tab) {
      const btnBaru = document.getElementById('tabPasienBaruBtn');
      const btnLama = document.getElementById('tabPasienLamaBtn');
      const boxLama = document.getElementById('boxPasienLama');
      const isNewInput = document.getElementById('resIsNew');

      if (tab === 'baru') {
        btnBaru.classList.add('active');
        btnLama.classList.remove('active');
        boxLama.style.display = 'none';
        isNewInput.value = 'true';
        document.getElementById('resNomorRm').value = '';
      } else {
        btnLama.classList.add('active');
        btnBaru.classList.remove('active');
