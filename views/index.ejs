    function doSearchPatient() {
      const q = document.getElementById('searchRmNikInput').value.trim();
      const feedback = document.getElementById('searchResultFeedback');
      if (!q) {
        showToast('Ketik Nomor RM atau NIK untuk mencari data!', 'error');
        return;
      }
      feedback.innerText = 'Mencari data pasien...';

      runApi('searchPatient', { query: q })
        .then(function(res) {
          if (res && res.found) {
            const p = res.patient;
            document.getElementById('resNomorRm').value = p.nomorRm;
            document.getElementById('resNik').value = p.nik;
            document.getElementById('resNama').value = p.nama;
            document.getElementById('resTglLahir').value = p.tanggalLahir;
            document.getElementById('resGender').value = p.jenisKelamin;
            document.getElementById('resNoHp').value = p.noHp;
            document.getElementById('resAlamat').value = p.alamat;
            document.getElementById('resAlergi').value = p.alergiObat;
            feedback.innerHTML = '<span style="color:#059669;"><i class="fa-solid fa-check"></i> Pasien Terdaftar: ' + p.nama + ' (' + p.nomorRm + ')</span>';
            showToast('Data rekam medis ditemukan!', 'success');
          } else {
            feedback.innerHTML = '<span style="color:#dc2626;"><i class="fa-solid fa-xmark"></i> Data tidak ditemukan. Silakan mendaftar di tab Pasien Baru.</span>';
          }
        })
        .catch(function(err) {
          feedback.innerText = 'Error: ' + err.toString();
        });
    }

    /**
     * Submit Formulir Reservasi Mandiri:
     * Menjamin sanitasi format 62..., menyertakan Rencana Waktu Kunjungan,
     * serta Dual-Sync ke Local Redis & Google Apps Script.
     */
    function handleReservasiSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSubmitReservasi');
      const rawHp = document.getElementById('resNoHp').value.trim();
      const cleanHp = sanitizePhoneNumberToE164(rawHp);
      const rencanaWaktu = document.getElementById('resRencanaKunjungan').value;

      if (!rencanaWaktu) {
        showToast('Silakan pilih Rencana Waktu Kunjungan Anda!', 'error');
        document.getElementById('resRencanaKunjungan').focus();
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengonfirmasi Pendaftaran...';

      const payload = {
        isNewPatient: document.getElementById('resIsNew').value === 'true',
        nomorRm: document.getElementById('resNomorRm').value,
        nik: document.getElementById('resNik').value,
        nama: document.getElementById('resNama').value,
        patientName: document.getElementById('resNama').value,
        tanggalLahir: document.getElementById('resTglLahir').value,
        jenisKelamin: document.getElementById('resGender').value,
        noHp: cleanHp,
        phoneNumber: cleanHp,
        alamat: document.getElementById('resAlamat').value,
        alergiObat: document.getElementById('resAlergi').value,
        dokterId: document.getElementById('resDokterSelect').value || 'DOC-001',
        ruanganPoli: 'Poli Gigi & Spesialis',
        serviceType: 'Poli Gigi & Spesialis',
        rencanaWaktuKunjungan: rencanaWaktu,
        bookingDate: rencanaWaktu,
        keluhanUtama: document.getElementById('resKeluhan').value
      };

      // 1. Kirim ke Server Local Express / Upstash Redis
      runApi('registerAppointment', payload)
        .then(function(res) {
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Konfirmasi Pendaftaran Antrean';

          if (res && res.status === 'success') {
            showToast('Pendaftaran Berhasil! Nomor Antrean: ' + (res.kodeAntrean || res.bookingId), 'success');
            
            // 2. Sinkronkan secara langsung ke Google Apps Script (Dual-Commit)
            fetch(GAS_API_URL, {
              method: 'POST',
              headers: { 'Content-Type': 'text/plain;charset=utf-8' },
              body: JSON.stringify({ action: 'registerAppointment', payload: payload, args: [payload] })
            }).catch(function() {});

            document.getElementById('formReservasi').reset();
            setDefaultBookingTime();
          } else {
            showToast('Gagal mendaftar: ' + (res.message || 'Error server'), 'error');
          }
        })
        .catch(function(err) {
          // Fallback langsung tembak ke Google Apps Script jika server lokal gagal
          fetch(GAS_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ action: 'registerAppointment', payload: payload, args: [payload] })
          })
          .then(r => r.json())
          .then(function(gasRes) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Konfirmasi Pendaftaran Antrean';
            if (gasRes && gasRes.status === 'success') {
              showToast('Pendaftaran Sukses via Cloud Bridge! Kode: ' + (gasRes.kodeAntrean || gasRes.bookingId), 'success');
              document.getElementById('formReservasi').reset();
              setDefaultBookingTime();
            } else {
              showToast('Pendaftaran gagal: ' + (gasRes.message || 'Error'), 'error');
            }
          })
          .catch(function(fetchErr) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Konfirmasi Pendaftaran Antrean';
            showToast('Terjadi kendala jaringan: ' + fetchErr.toString(), 'error');
          });
        });
    }

    // =========================================================================
    // GROQ AI TEXT-TO-SPEECH & MONITOR TV RUANG ANTREAN
    // =========================================================================

    let tvPollingInterval = null;
    let isCurrentlyAnnouncing = false;

    function openTvQueue() {
      const tvView = document.getElementById('tvView');
      const landingView = document.getElementById('landingView');
      const siteHeader = document.querySelector('.site-header');
      const breadcrumbs = document.querySelector('.breadcrumb-trail');

      if (siteHeader) siteHeader.style.display = 'none';
      if (breadcrumbs) breadcrumbs.style.display = 'none';
      if (landingView) landingView.style.display = 'none';
      if (tvView) {
        tvView.style.display = 'block';
        tvView.classList.add('animate-fade-in');
      }

      fetchTvQueueData();
      if (!tvPollingInterval) {
        tvPollingInterval = setInterval(fetchTvQueueData, 5000);
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function closeTvQueue() {
      if (tvPollingInterval) {
        clearInterval(tvPollingInterval);
        tvPollingInterval = null;
      }
      window.location.href = '/';
    }

    function fetchTvQueueData() {
      const poli = document.getElementById('tvFilterPoli').value;
      runApi('getQueueTvData', { poli: poli })
        .then(function(res) {
          if (res && res.status === 'success') {
            updateTvDisplay(res.activeQueue, res.nextQueues);
          }
        })
        .catch(function(err) {
          console.error('Error fetchTvQueueData:', err);
        });
    }

    function updateTvDisplay(active, nextList) {
      const numElem = document.getElementById('tvCurrentQueue');
      const roomElem = document.getElementById('tvCurrentRoom');
      const docElem = document.getElementById('tvCurrentDoctor');
      const nextElem = document.getElementById('tvNextList');
      const boxElem = document.getElementById('tvCallBox');

      if (active) {
        const isNewCall = numElem.innerText !== active.kode;
        numElem.innerText = active.kode;
        roomElem.innerText = active.ruanganPoli;
        docElem.innerText = active.dokterNama;

        if (isNewCall) {
          boxElem.classList.add('calling');
          announceQueueWithAiVoice(active.kode, active.ruanganPoli, active.dokterNama);
          setTimeout(() => boxElem.classList.remove('calling'), 12000);
        }
      } else {
        numElem.innerText = '---';
        roomElem.innerText = 'Menunggu Pasien...';
        docElem.innerText = 'Estaka Dental Clinic';
        boxElem.classList.remove('calling');
      }

      let html = '';
      if (nextList && nextList.length > 0) {
        for (let i = 0; i < nextList.length; i++) {
          const item = nextList[i];
          html += '<div style="background:#1e293b; padding:8px 12px; border-radius:10px; display:flex; justify-content:space-between; align-items:center;">' +
            '<div>' +
              '<div style="font-weight:700; color:#38bdf8; font-size:0.9rem;">' + item.kode + '</div>' +
              '<div style="font-size:0.75rem; color:#94a3b8;">' + item.namaPasien + '</div>' +
            '</div>' +
            '<div style="font-size:0.75rem; color:#cbd5e1;">' + item.ruanganPoli + '</div>' +
          '</div>';
        }
      } else {
        html = '<div style="color:#64748b; font-size:0.8rem; text-align:center;">Belum ada antrean berikutnya.</div>';
      }
      nextElem.innerHTML = html;
    }

    function playAudioChime() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);
        osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.18);
        osc.frequency.setValueAtTime(1174.66, audioCtx.currentTime + 0.38);
        gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.85);

        osc.start();
        osc.stop(audioCtx.currentTime + 0.85);
      } catch (e) {
        console.warn('Audio chime note:', e);
      }
    }

    function formatKodeForSpeech(kode) {
      if (!kode) return 'A N T 1';
      const parts = kode.split('-');
      const last = parts[parts.length - 1];
      const numVal = parseInt(last, 10);
      const friendlyNum = !isNaN(numVal) ? numVal.toString() : last;
      return "A N T " + friendlyNum;
    }

    function announceQueueWithAiVoice(kode, poli, dokter) {
      if (isCurrentlyAnnouncing) return;
      isCurrentlyAnnouncing = true;

      const badge = document.getElementById('tvAudioStatusBadge');
      if (badge) badge.style.display = 'block';

      playAudioChime();

      const engineSelect = document.getElementById('tvVoiceEngine');
      const selectedModel = engineSelect ? engineSelect.value : (systemTtsModel || 'canopylabs/orpheus-arabic-saudi');
      
      const personaSelect = document.getElementById('tvVoicePersona');
      const selectedVoice = personaSelect ? personaSelect.value : (systemTtsVoice || 'abdullah');

      const friendlyKode = formatKodeForSpeech(kode);
      const cleanRoom = poli || 'ruang periksa poli gigi';

      const indonesianInput = "Nomor antrean, " + friendlyKode + ". Silakan menuju ke " + cleanRoom + ". Terima kasih.";

      setTimeout(function() {
        if (selectedModel === 'web-speech') {
          executeNativeWebSpeechAnnouncement(indonesianInput, function() {
            isCurrentlyAnnouncing = false;
            if (badge) badge.style.display = 'none';
          });
        } else {
          executeGroqAudioSpeech(selectedModel, selectedVoice, indonesianInput, function() {
            isCurrentlyAnnouncing = false;
            if (badge) badge.style.display = 'none';
          });
        }
      }, 700);
    }

    function executeGroqAudioSpeech(model, voice, inputSpeechText, callback) {
      showToast('🎙️ Memanggil via Groq Orpheus AI (' + (voice || 'abdullah') + ')...', 'groq');

      fetch('/api/groq/tts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: model || 'canopylabs/orpheus-arabic-saudi',
          voice: voice || 'abdullah',
          input: inputSpeechText
        })
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Proxy TTS status ' + res.status);
        return res.blob();
      })
      .then(function(blob) {
        playTtsAudioBlob(blob, inputSpeechText, callback);
      })
      .catch(function(err) {
        const apiKey = systemGroqKey || localStorage.getItem('akshara_groq_key') || '';
        if (apiKey) {
          fetch('https://api.groq.com/openai/v1/audio/speech', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + apiKey,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              model: model || 'canopylabs/orpheus-arabic-saudi',
              voice: voice || 'abdullah',
              response_format: 'wav',
              input: inputSpeechText
            })
          })
          .then(res => res.blob())
          .then(blob => playTtsAudioBlob(blob, inputSpeechText, callback))
          .catch(() => executeNativeWebSpeechAnnouncement(inputSpeechText, callback));
        } else {
          executeNativeWebSpeechAnnouncement(inputSpeechText, callback);
        }
      });
    }

    function playTtsAudioBlob(blob, fallbackText, callback) {
      const audioUrl = URL.createObjectURL(blob);
      const audio = new Audio(audioUrl);
      audio.onended = function() {
        URL.revokeObjectURL(audioUrl);
        if (callback) callback();
      };
      audio.onerror = function() {
        URL.revokeObjectURL(audioUrl);
        executeNativeWebSpeechAnnouncement(fallbackText, callback);
      };
      audio.play().catch(function() {
        executeNativeWebSpeechAnnouncement(fallbackText, callback);
      });
    }

    function executeNativeWebSpeechAnnouncement(text, callback) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'id-ID';
        utterance.rate = 0.9;
        utterance.pitch = 1.05;
        utterance.onend = function() { if (callback) callback(); };
        utterance.onerror = function() { if (callback) callback(); };
        window.speechSynthesis.speak(utterance);
      } else {
        if (callback) callback();
      }
    }

    function testQueueVoiceAnnouncement() {
      showToast('Menguji pemanggilan suara AI Groq Orpheus...', 'groq');
      announceQueueWithAiVoice('ANT-20260908-0001', 'Poli Spesialis Konservasi', 'drg. Hj. Kurniawaty, Sp.KG');
    }

