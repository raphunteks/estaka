  <script>
    let lastSecurityAlertTime = 0;

    function triggerDevtoolsSecurityAlert(reason) {
      const now = Date.now();
      if (now - lastSecurityAlertTime < 2500) return;
      lastSecurityAlertTime = now;

      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.35);
      } catch (e) {}

      const modal = document.getElementById('devtoolsSecurityModal');
      if (modal) modal.classList.add('show');
    }

    function closeDevtoolsSecurityModal() {
      const modal = document.getElementById('devtoolsSecurityModal');
      if (modal) modal.classList.remove('show');
    }

    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
      triggerDevtoolsSecurityAlert('Context menu blocked');
      return false;
    });

    document.addEventListener('keydown', function(e) {
      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
      const cmdOrCtrl = isMac ? e.metaKey : e.ctrlKey;

      if (
        e.keyCode === 123 ||
        (cmdOrCtrl && e.shiftKey && (e.keyCode === 73 || e.keyCode === 74 || e.keyCode === 67)) ||
        (cmdOrCtrl && (e.keyCode === 85 || e.keyCode === 83))
      ) {
        e.preventDefault();
        triggerDevtoolsSecurityAlert('DevTools shortcut detected');
        return false;
      }
    });

    setInterval(function() {
      console.clear();
    }, 4000);

    // DUAL-MODE API CLIENT: Default Express Local/Redis Router -> Google Apps Script Fallback
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbzZ8HVyql76ZZbVY7qk8HISf9h8d8xfs6zb4NlrjUZu_MkEYlZMLbjoS300_ap80h-e/exec";

    /**
     * Helper Sanitasi Nomor WhatsApp Otomatis ke Format Internasional (62...)
     */
    function sanitizePhoneNumberToE164(raw) {
      let cleaned = String(raw || '').replace(/\D/g, '');
      if (cleaned.startsWith('0')) {
        cleaned = '62' + cleaned.substring(1);
      } else if (cleaned.startsWith('8')) {
        cleaned = '62' + cleaned;
      } else if (!cleaned.startsWith('62') && cleaned.length >= 8) {
        cleaned = '62' + cleaned;
      }
      return cleaned;
    }

    function runApi(actionName, payloadData) {
      return new Promise(function(resolve, reject) {
        fetch('/api/router', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: actionName, payload: payloadData || {} })
        })
        .then(function(res) {
          if (res.ok) return res.json();
          throw new Error('Local router HTTP ' + res.status);
        })
        .then(function(data) { resolve(data); })
        .catch(function(localErr) {
          // Fallback ke Google Apps Script jika local router tidak tersedia
          fetch(GAS_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({ action: actionName, payload: payloadData || {}, args: [payloadData || {}] })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) { resolve(data); })
          .catch(function(gasErr) { reject(localErr); });
        });
      });
    }

    // STATE DOKTER DEFAULT (3 DOKTER GIGI RESMI ESTAKA DENTAL CLINIC)
    let clinicDoctors = [
      {
        id: 'DOC-001',
        nama: 'drg. Hj. Kurniawaty, Sp.KG',
        kategori: 'Dokter Gigi Spesialis',
        spesialisasi: 'Konservasi Gigi (Endodontik)',
        sip: 'SIP: 503/SIP-DS/2024/001',
        hari: 'Senin - Sabtu',
        jamMulai: '16:00',
        jamSelesai: '21:00',
        kuota: '20'
      },
      {
        id: 'DOC-002',
        nama: 'drg. M. Aksa Arsyad',
        kategori: 'Dokter Gigi',
        spesialisasi: 'Kedokteran Gigi Umum & Estetika',
        sip: 'SIP: 503/SIP-DG/2024/002',
        hari: 'Senin - Sabtu',
        jamMulai: '09:00',
        jamSelesai: '16:00',
        kuota: '25'
      },
      {
        id: 'DOC-003',
        nama: 'drg. Tasya Awaliyah Arsyad',
        kategori: 'Dokter Gigi',
        spesialisasi: 'Kedokteran Gigi Umum & Estetika',
        sip: 'SIP: 503/SIP-DG/2024/003',
        hari: 'Senin - Sabtu',
        jamMulai: '13:00',
        jamSelesai: '20:00',
        kuota: '25'
      }
    ];

    let currentSlide = 0;
    let slideTimer = null;
    let deferredPwaPrompt = null;
    
    // PERSISTENT GROQ SETTINGS
    let systemGroqKey = localStorage.getItem('akshara_groq_key') || '';
    let systemTtsModel = localStorage.getItem('akshara_tts_model') || 'canopylabs/orpheus-arabic-saudi';
    let systemTtsVoice = localStorage.getItem('akshara_tts_voice') || 'abdullah';

    window.addEventListener('DOMContentLoaded', function() {
      initTheme();
      initHeroSlider();
      renderDoctorCards(clinicDoctors);
      populateDoctorSelect(clinicDoctors);
      loadPublicData();
      initInlineServiceWorker();
      initScrollToTopListener();
      checkCurrentRouteTab();
      setDefaultBookingTime();

      syncTtsSelectors(systemTtsModel, systemTtsVoice);
    });

    function setDefaultBookingTime() {
      const timeInput = document.getElementById('resRencanaKunjungan');
      if (timeInput && !timeInput.value) {
        const now = new Date();
        now.setHours(now.getHours() + 2); // Default 2 jam ke depan
        const pad = n => String(n).padStart(2, '0');
        const formatted = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
        timeInput.value = formatted;
      }
    }

    function showToast(msg, type) {
      const box = document.getElementById('toastBox');
      box.className = 'toast-box ' + (type || 'info');
      box.innerText = msg;
      box.style.display = 'block';
      setTimeout(function() { box.style.display = 'none'; }, 4000);
    }

    function checkCurrentRouteTab() {
      const currentPath = window.location.pathname;
      if (currentPath === '/antrean-tv' || window.location.search.includes('display=true')) {
        openTvQueue();
      } else if (currentPath === '/layanan') {
        scrollToSection('layanan');
      } else if (currentPath === '/dokter') {
        scrollToSection('dokter');
      } else if (currentPath === '/reservasi') {
        scrollToSection('reservasi');
      } else if (currentPath === '/kontak') {
        scrollToSection('kontak');
      }
    }

    function scrollToSection(id) {
      setTimeout(() => {
        const el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }, 200);
    }

    function initScrollToTopListener() {
      const btn = document.getElementById('scrollToTopBtn');
      window.addEventListener('scroll', function() {
        if (window.pageYOffset > 280) {
          btn.classList.add('show');
        } else {
          btn.classList.remove('show');
        }
      });
    }

    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleMobileMenu() {
      document.getElementById('mobileDrawer').classList.toggle('open');
    }

    function closeMobileMenu() {
      document.getElementById('mobileDrawer').classList.remove('open');
    }

    function initTheme() {
      const savedTheme = localStorage.getItem('akshara_theme') || 'theme-white';
      document.body.className = savedTheme;
      updateThemeLabel(savedTheme);
    }

    function toggleTheme() {
      const current = document.body.className;
      const next = current === 'theme-white' ? 'theme-blue' : 'theme-white';
      document.body.className = next;
      localStorage.setItem('akshara_theme', next);
      updateThemeLabel(next);
      showToast('Tema diubah ke: ' + (next === 'theme-white' ? 'White Higienis' : 'Blue Cyan Soft'), 'info');
    }

    function updateThemeLabel(theme) {
      const label = document.getElementById('themeLabel');
      if (label) {
        label.innerText = theme === 'theme-white' ? 'Tema Putih' : 'Tema Biru';
      }
    }

    function initHeroSlider() {
      slideTimer = setInterval(function() {
        nextSlide();
      }, 5000);
    }

    function nextSlide() {
      jumpSlide((currentSlide + 1) % 3);
    }

    function jumpSlide(index) {
      currentSlide = index;
      const slides = document.querySelectorAll('.slide-item');
      const dots = document.querySelectorAll('.slider-dot');
      for (let i = 0; i < slides.length; i++) {
        slides[i].classList.remove('active');
        if (dots[i]) dots[i].classList.remove('active');
      }
      if (slides[currentSlide]) slides[currentSlide].classList.add('active');
      if (dots[currentSlide]) dots[currentSlide].classList.add('active');
    }

    function loadPublicData() {
      runApi('getInitialData', {})
        .then(function(res) {
          if (res && res.status === 'success') {
            if (res.dokters && res.dokters.length > 0) {
              clinicDoctors = res.dokters;
              renderDoctorCards(clinicDoctors);
              populateDoctorSelect(clinicDoctors);
            }
            if (res.settings) {
              if (res.settings.GROQ_TTS_MODEL) systemTtsModel = res.settings.GROQ_TTS_MODEL;
              if (res.settings.GROQ_TTS_VOICE) systemTtsVoice = res.settings.GROQ_TTS_VOICE;
              syncTtsSelectors(systemTtsModel, systemTtsVoice);
            }
          }
        })
        .catch(function(err) {
          console.warn('Load public data status:', err);
        });
    }

    function syncTtsSelectors(modelName, voiceName) {
      systemTtsModel = modelName || 'canopylabs/orpheus-arabic-saudi';
      systemTtsVoice = voiceName || 'abdullah';
      localStorage.setItem('akshara_tts_model', systemTtsModel);
      localStorage.setItem('akshara_tts_voice', systemTtsVoice);

      const tvTtsSel = document.getElementById('tvVoiceEngine');
      if (tvTtsSel) tvTtsSel.value = systemTtsModel;
      const tvVoiceSel = document.getElementById('tvVoicePersona');
      if (tvVoiceSel) tvVoiceSel.value = systemTtsVoice;
    }

    function syncTtsSettingsFromTv(modelName, voiceName) {
      syncTtsSelectors(modelName, voiceName);
      showToast('Pengaturan suara TV diperbarui: ' + voiceName, 'info');
    }

    function renderDoctorCards(doctors) {
      const container = document.getElementById('doctorListContainer');
      if (!container) return;
      let html = '';
      for (let i = 0; i < doctors.length; i++) {
        const d = doctors[i];
        html += '<div class="glass-card service-card animate-swipe-up">' +
          '<div style="font-size:0.75rem; font-weight:700; color:var(--primary); text-transform:uppercase; margin-bottom:6px;">' + d.kategori + '</div>' +
          '<h3 style="font-size:1.15rem; font-weight:800; margin-bottom:4px;">' + d.nama + '</h3>' +
          '<div style="color:var(--text-muted); font-size:0.85rem; margin-bottom:10px;">' + d.spesialisasi + '</div>' +
          '<div style="font-size:0.82rem; color:var(--text-main); line-height:1.5;">' +
            '<div><i class="fa-solid fa-id-badge" style="color:var(--primary);"></i> ' + (d.sip || 'SIP Terdaftar') + '</div>' +
            '<div><i class="fa-solid fa-calendar-day" style="color:var(--primary);"></i> ' + d.hari + '</div>' +
            '<div><i class="fa-solid fa-clock" style="color:var(--primary);"></i> ' + d.jamMulai + ' - ' + d.jamSelesai + ' WITA</div>' +
          '</div>' +
          '<div style="margin-top:12px;">' +
            '<a href="/reservasi" class="nav-btn btn-outline" style="width:100%; justify-content:center; text-decoration:none; font-size:0.8rem;" onclick="selectDoctorBooking(\'' + d.id + '\')">' +
              '<i class="fa-solid fa-calendar-plus"></i> Buat Janji Konsultasi' +
            '</a>' +
          '</div>' +
        '</div>';
      }
      container.innerHTML = html;
    }

    function populateDoctorSelect(doctors) {
      const sel = document.getElementById('resDokterSelect');
      if (!sel) return;
      let html = '<option value="">-- Pilih Dokter Gigi Pemeriksa --</option>';
      for (let i = 0; i < doctors.length; i++) {
        const d = doctors[i];
        html += '<option value="' + d.id + '">' + d.nama + ' (' + d.spesialisasi + ')</option>';
      }
      sel.innerHTML = html;
    }

