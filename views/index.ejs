<!DOCTYPE html>
<html lang="id" itemscope itemtype="https://schema.org/Dentist">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title><%= seo.title %></title>
  <meta name="google-site-verification" content="cbSE7olGd0ibEx_bhjC3aitjIovXCSwUKYbVOh7nbLs" />
  <meta name="title" content="<%= seo.title %>" />
  <meta name="description" content="<%= seo.description %>" />
  <meta name="keywords" content="<%= seo.keywords %>" />
  <meta name="author" content="Estaka Dental Clinic" />
  <meta name="publisher" content="Estaka Dental Clinic" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Canonical & Alternate Reference -->
  <link rel="canonical" href="<%= seo.canonicalUrl %>" />
  <link rel="alternate" hreflang="id-ID" href="<%= seo.canonicalUrl %>" />
  <link rel="alternate" hreflang="x-default" href="https://aksharadental.space/" />
  <link rel="alternate" href="https://aksharadental.space/" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

  <meta name="geo.region" content="ID-SN" />
  <meta name="geo.placename" content="Makassar" />
  <meta name="geo.position" content="-5.171147;119.417230" />
  <meta name="ICBM" content="-5.171147, 119.417230" />

  <!-- Open Graph / Facebook (Favicon & Preview Image PNG 100% SEO) -->
  <meta property="og:locale" content="id_ID" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= seo.title %>" />
  <meta property="og:description" content="<%= seo.description %>" />
  <meta property="og:url" content="<%= seo.canonicalUrl %>" />
  <meta property="og:site_name" content="Estaka Dental Clinic" />
  <meta property="og:image" content="<%= seo.baseUrl %>/img/etakalogo.png" />
  <meta property="og:image:secure_url" content="<%= seo.baseUrl %>/img/etakalogo.png" />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta property="og:image:alt" content="Logo Resmi Estaka Dental Clinic Makassar" />
  <meta property="og:image:type" content="image/png" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= seo.title %>" />
  <meta name="twitter:description" content="<%= seo.description %>" />
  <meta name="twitter:image" content="<%= seo.baseUrl %>/img/etakalogo.png" />
  <meta name="twitter:image:alt" content="Estaka Dental Clinic" />

  <!-- Favicon & Touch Icons Berbasis PNG etakalogo.png -->
  <link rel="icon" type="image/png" href="/img/etakalogo.png" />
  <link rel="shortcut icon" type="image/png" href="/img/etakalogo.png" />
  <link rel="apple-touch-icon" type="image/png" href="/img/etakalogo.png" />
  <link rel="manifest" href="data:application/manifest+json;utf-8,%7B%22name%22%3A%22Estaka%20Dental%20Clinic%22%2C%22short_name%22%3A%22EstakaDental%22%2C%22start_url%22%3A%22.%2F%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23f8fafc%22%2C%22theme_color%22%3A%22%230284c7%22%2C%22icons%22%3A%5B%7B%22src%22%3A%22%2Fimg%2Fetakalogo.png%22%2C%22sizes%22%3A%22192x192%20512x512%22%2C%22type%22%3A%22image%2Fpng%22%7D%5D%7D" />
  <meta name="theme-color" content="#0284c7" />

  <!-- External Typography & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Modular Stylesheet -->
  <link rel="stylesheet" href="/css/main.css" />

  <!-- Structured Data JSON-LD Dinamis GSC -->
  <script type="application/ld+json">
  <%- JSON.stringify(seo.jsonLd) %>
  </script>
</head>
<body class="theme-white">

  <!-- Toast Notification Box -->
  <div id="toastBox" class="toast-box" role="status" aria-live="polite"></div>

  <!-- Scroll To Top Button -->
  <button id="scrollToTopBtn" class="scroll-top-btn" onclick="scrollToTop()" title="Kembali ke Atas" aria-label="Kembali ke atas">
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <!-- DevTools Protection Modal -->
  <div class="modal-overlay" id="devtoolsSecurityModal" role="dialog" aria-modal="true" aria-labelledby="secModalTitle">
    <div class="glass-card modal-box" style="background:rgba(15,23,42,0.97); border:2px solid #ef4444; color:#ffffff; text-align:center;">
      <div style="width:64px; height:64px; border-radius:50%; background:rgba(239,68,68,0.2); border:2px solid #ef4444; color:#ef4444; display:flex; align-items:center; justify-content:center; font-size:1.8rem; margin:0 auto 14px;">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h3 id="secModalTitle" style="font-size:1.2rem; font-weight:800; color:#ef4444; margin-bottom:8px;">
        AKSES DEVTOOLS DIBATASI
      </h3>
      <div style="font-size:0.75rem; font-weight:700; color:#cbd5e1; background:rgba(239,68,68,0.25); padding:4px 10px; border-radius:20px; display:inline-block; margin-bottom:12px;">
        PERMENKES NO. 24 TAHUN 2022 — REKAM MEDIS ELEKTRONIK
      </div>
      <p style="font-size:0.84rem; color:#e2e8f0; line-height:1.5; margin-bottom:16px;">
        Fitur inspeksi kode dan pintasan developer tools dinonaktifkan demi menjaga integritas serta kerahasiaan riwayat medis pasien Estaka Dental Clinic.
      </p>
      <button class="nav-btn btn-primary" style="background:#ef4444; border:none; padding:10px 20px; margin:0 auto;" onclick="closeDevtoolsSecurityModal()">
        <i class="fa-solid fa-check"></i> Saya Mengerti & Lanjutkan
      </button>
    </div>
  </div>

  <!-- Header Navigasi -->
  <header class="site-header" role="banner">
    <a href="/" class="brand-logo" aria-label="Beranda Estaka Dental Clinic">
      <div class="brand-icon">
        <img src="/img/etakalogo.png" alt="Logo Estaka Dental" onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\'fa-solid fa-tooth\'></i>';" />
      </div>
      <div>
        <div class="brand-title">Estaka Dental Clinic</div>
        <div class="brand-subtitle">Modern Dental Care & Aesthetic Space</div>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" role="navigation" aria-label="Navigasi Utama">
      <li class="nav-item"><a href="/" class="<%= activeTab === 'beranda' ? 'active' : '' %>">Beranda</a></li>
      <li class="nav-item"><a href="/layanan" class="<%= activeTab === 'layanan' ? 'active' : '' %>">Layanan Dental</a></li>
      <li class="nav-item"><a href="/dokter" class="<%= activeTab === 'dokter' ? 'active' : '' %>">Dokter & Jadwal</a></li>
      <li class="nav-item"><a href="/reservasi" class="<%= activeTab === 'reservasi' ? 'active' : '' %>">Reservasi</a></li>
      <li class="nav-item"><a href="/kontak" class="<%= activeTab === 'kontak' ? 'active' : '' %>">Kontak</a></li>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <button class="nav-btn btn-outline" id="themeToggleBtn" onclick="toggleTheme()" title="Ubah Tema Warna">
        <i class="fa-solid fa-circle-half-stroke"></i> <span id="themeLabel">Tema Putih</span>
      </button>

      <a href="/antrean-tv" class="nav-btn btn-outline header-extra-btn" style="text-decoration:none;" title="Buka TV Ruang Antrean">
        <i class="fa-solid fa-tv"></i> <span>TV Antrean</span>
      </a>

      <button class="nav-btn btn-primary header-extra-btn" onclick="openLoginModal()" title="Gerbang Akses Staf Medis">
        <i class="fa-solid fa-user-shield"></i> <span>Portal Staf</span>
      </button>

      <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Buka Menu Navigasi Mobile">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </header>

  <!-- Mobile Drawer Menu -->
  <div id="mobileDrawer" class="mobile-nav-drawer" role="navigation" aria-label="Navigasi Mobile">
    <a href="/" onclick="closeMobileMenu();"><i class="fa-solid fa-house"></i> Beranda</a>
    <a href="/layanan" onclick="closeMobileMenu();"><i class="fa-solid fa-tooth"></i> Layanan Gigi Terpadu</a>
    <a href="/dokter" onclick="closeMobileMenu();"><i class="fa-solid fa-user-doctor"></i> Dokter & Jadwal Praktek</a>
    <a href="/reservasi" onclick="closeMobileMenu();"><i class="fa-solid fa-calendar-check"></i> Reservasi Mandiri</a>
    <a href="/kontak" onclick="closeMobileMenu();"><i class="fa-solid fa-location-dot"></i> Kontak & Lokasi</a>
    <a href="/antrean-tv" onclick="closeMobileMenu();"><i class="fa-solid fa-tv" style="color:var(--primary);"></i> TV Ruang Antrean</a>
    <button onclick="closeMobileMenu(); openLoginModal();"><i class="fa-solid fa-user-shield" style="color:#059669;"></i> Portal Staf Medis</button>
  </div>

  <!-- Breadcrumbs -->
  <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
    <a href="/"><i class="fa-solid fa-house"></i> Beranda</a>
    <span style="color:#94a3b8;">/</span>
    <a href="/layanan">Layanan Gigi</a>
    <span style="color:#94a3b8;">/</span>
    <a href="/dokter">Dokter Gigi Spesialis</a>
    <span style="color:#94a3b8;">/</span>
    <a href="/reservasi">Reservasi Online</a>
  </nav>

  <main id="appRoot">

    <!-- LANDING PAGE VIEW -->
    <div id="landingView" class="view-transition">
      
      <!-- Hero Section -->
      <section class="hero-section" id="beranda" aria-label="Sorotan Utama">
        <div class="slider-container">
          <!-- Slide 1 -->
          <article class="slide-item active" style="background-image:url('https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1600&q=80');">
            <div class="slide-overlay"></div>
            <div class="slide-content">
              <span style="background:rgba(56,189,248,0.25); border:1px solid #38bdf8; padding:4px 10px; border-radius:16px; font-size:0.75rem; font-weight:700;">DIGITAL DENTAL HEALTHCARE 4.0</span>
              <h1>Presisi Estetika & Konservasi Gigi Modern</h1>
              <p>Perawatan gigi komprehensif didukung keahlian Spesialis Konservasi Gigi (Endodontik), teknologi radiologi digital, dan Groq LPU AI Medical Inference di Makassar.</p>
              <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <a href="/reservasi" class="nav-btn btn-primary" style="text-decoration:none;"><i class="fa-solid fa-calendar-check"></i> Reservasi Mandiri</a>
                <button class="nav-btn btn-outline" style="color:#fff; border-color:#fff; background:rgba(255,255,255,0.15);" onclick="openPwaModal()"><i class="fa-solid fa-mobile-screen"></i> Unduh App PWA</button>
              </div>
            </div>
          </article>
          <!-- Slide 2 -->
          <article class="slide-item" style="background-image:url('https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&w=1600&q=80');">
            <div class="slide-overlay"></div>
            <div class="slide-content">
              <span style="background:rgba(56,189,248,0.25); border:1px solid #38bdf8; padding:4px 10px; border-radius:16px; font-size:0.75rem; font-weight:700;">REKAM MEDIS ELEKTRONIK (EMR)</span>
              <h1>Odontogram Interaktif 52 Elemen Gigi</h1>
              <p>Riwayat karies dentin, restorasi komposit, endodontik, hingga mahkota gigi terpantau presisi dan terenkripsi standar Kemenkes RI.</p>
              <a href="/dokter" class="nav-btn btn-primary" style="text-decoration:none;"><i class="fa-solid fa-user-doctor"></i> Jadwal Dokter Gigi</a>
            </div>
          </article>
          <!-- Slide 3 -->
          <article class="slide-item" style="background-image:url('https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1600&q=80');">
            <div class="slide-overlay"></div>
            <div class="slide-content">
              <span style="background:rgba(249,115,22,0.3); border:1px solid #f97316; padding:4px 10px; border-radius:16px; font-size:0.75rem; font-weight:700; color:#fed7aa;">⚡ GROQ LPU AI & ORPHEUS TTS</span>
              <h1>Diagnosa Cerdas & Monitor Antrean AI</h1>
              <p>Didukung inferensi Groq LPU super cepat untuk diferensial diagnosa ICD-10 serta suara pemanggilan antrean otomatis bertenaga Canopy Labs Orpheus AI.</p>
              <a href="/reservasi" class="nav-btn btn-primary" style="text-decoration:none;"><i class="fa-solid fa-hospital-user"></i> Cek Nomor Antrean</a>
            </div>
          </article>

          <div class="slider-dots">
            <div class="slider-dot active" onclick="jumpSlide(0)" aria-label="Slide 1"></div>
            <div class="slider-dot" onclick="jumpSlide(1)" aria-label="Slide 2"></div>
            <div class="slider-dot" onclick="jumpSlide(2)" aria-label="Slide 3"></div>
          </div>
        </div>
      </section>

      <!-- Layanan Unggulan Gigi Terpadu -->
      <section class="container animate-swipe-up" id="layanan" aria-label="Layanan Dental Unggulan">
        <div class="section-title">
          <h2>Layanan Gigi Spesialis Terpadu</h2>
          <p>Pelayanan kesehatan gigi profesional, modern, dan higienis berstandar mutu tinggi</p>
        </div>
        <div class="services-grid">
          <div class="glass-card service-card">
            <div class="service-icon"><i class="fa-solid fa-tooth"></i></div>
            <h3 style="font-size:1.15rem; font-weight:700; margin-bottom:8px;">Konservasi & Endodontik</h3>
            <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.5;">Perawatan saluran akar tanpa rasa sakit, penambalan resin komposit estetik, dan preservasi vitalitas pulpa gigi.</p>
          </div>
          <div class="glass-card service-card">
            <div class="service-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
            <h3 style="font-size:1.15rem; font-weight:700; margin-bottom:8px;">Estetika & Pemutihan Gigi</h3>
            <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.5;">Direct veneer, pemutihan gigi (teeth whitening/bleaching) profesional, dan pembersihan karang gigi (scaling ultrasonik).</p>
          </div>
          <div class="glass-card service-card">
            <div class="service-icon"><i class="fa-solid fa-teeth-open"></i></div>
            <h3 style="font-size:1.15rem; font-weight:700; margin-bottom:8px;">Kedokteran Gigi Umum & Preventif</h3>
            <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.5;">Pemeriksaan kesehatan rongga mulut menyeluruh, penambalan preventif, aplikasi fluoride, serta pencabutan gigi atraumatik.</p>
          </div>
          <div class="glass-card service-card">
            <div class="service-icon"><i class="fa-solid fa-flask-vial"></i></div>
            <h3 style="font-size:1.15rem; font-weight:700; margin-bottom:8px;">Farmasi & Diagnostik Terpadu</h3>
            <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.5;">Rujukan radiologi panoramik/periapikal, e-resep farmasi instan, dan sistem otomatis pencegahan kontraindikasi alergi obat.</p>
          </div>
        </div>
      </section>

      <!-- Dokter & Jadwal Praktek (3 Dokter Gigi Resmi Estaka) -->
      <section class="container animate-swipe-up" id="dokter" aria-label="Profil Dokter Gigi">
        <div class="section-title">
          <h2>Tim Dokter Gigi Profesional</h2>
          <p>Dokter gigi spesialis dan dokter gigi berpengalaman Estaka Dental Clinic Makassar</p>
        </div>
        <div id="doctorListContainer" class="services-grid"></div>
      </section>

      <!-- Form Reservasi Mandiri Pasien (Dengan Field Rencana Waktu Kunjungan) -->
      <section class="container animate-swipe-up" id="reservasi" aria-label="Pendaftaran Pasien Online">
        <div class="section-title">
          <h2>Reservasi Mandiri Pasien</h2>
          <p>Dapatkan nomor antrean dan kepastian slot waktu konsultasi tanpa antre manual di klinik</p>
        </div>
        <div class="glass-card reservasi-card">
          <div class="form-tabs">
            <button class="tab-btn active" id="tabPasienBaruBtn" onclick="switchReservasiTab('baru')">
              <i class="fa-solid fa-user-plus"></i> Pasien Baru
            </button>
            <button class="tab-btn" id="tabPasienLamaBtn" onclick="switchReservasiTab('lama')">
              <i class="fa-solid fa-id-card"></i> Pasien Lama (Cari NIK / No RM)
            </button>
          </div>

          <!-- Pencarian Pasien Lama -->
          <div id="boxPasienLama" style="display:none; margin-bottom:20px; padding:14px; border-radius:12px; background:var(--badge-bg);">
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
              <input type="text" id="searchRmNikInput" placeholder="Masukkan Nomor RM atau 16 Digit NIK KTP..." style="flex:1; min-width:200px;" />
              <button class="nav-btn btn-primary" onclick="doSearchPatient()"><i class="fa-solid fa-magnifying-glass"></i> Cari Data Pasien</button>
            </div>
            <div id="searchResultFeedback" style="margin-top:8px; font-size:0.85rem; font-weight:600;"></div>
          </div>

          <!-- Form Input Pasien Terpadu -->
          <form id="formReservasi" onsubmit="handleReservasiSubmit(event)">
            <input type="hidden" id="resNomorRm" value="" />
            <input type="hidden" id="resIsNew" value="true" />

            <div class="form-grid">
              <div class="form-group">
                <label for="resNik">Nomor Induk Kependudukan (NIK) *</label>
                <input type="number" id="resNik" required placeholder="16 Digit NIK KTP Pasien..." />
              </div>
              <div class="form-group">
                <label for="resNama">Nama Lengkap Pasien *</label>
                <input type="text" id="resNama" required placeholder="Sesuai KTP / Kartu Identitas..." />
              </div>
              <div class="form-group">
                <label for="resTglLahir">Tanggal Lahir *</label>
                <input type="date" id="resTglLahir" required />
              </div>
              <div class="form-group">
                <label for="resGender">Jenis Kelamin *</label>
                <select id="resGender" required>
                  <option value="Laki-Laki">Laki-Laki</option>
                  <option value="Perempuan">Perempuan</option>
                </select>
              </div>
              <div class="form-group">
                <label for="resNoHp">Nomor WhatsApp Aktif *</label>
                <input type="tel" id="resNoHp" required placeholder="Contoh: 08xxxxxxxxxx (Auto 62)" />
              </div>
              <div class="form-group">
                <label for="resDokterSelect">Pilih Dokter Gigi Pemeriksa *</label>
                <select id="resDokterSelect" required></select>
              </div>
              
              <!-- Form Baru: Rencana Waktu Kunjungan (Gambar 2) -->
              <div class="form-group full">
                <label for="resRencanaKunjungan" style="font-weight:700; color:var(--primary);">
                  <i class="fa-solid fa-calendar-clock"></i> Rencana Waktu Kunjungan *
                </label>
                <input type="datetime-local" id="resRencanaKunjungan" required style="font-weight:600;" />
              </div>

              <div class="form-group full">
                <label for="resAlamat">Alamat Domisili Lengkap *</label>
                <input type="text" id="resAlamat" required placeholder="Nama jalan, nomor rumah, kelurahan, kota domisili..." />
              </div>
              <div class="form-group full">
                <label for="resAlergi">Riwayat Alergi Obat (Sangat Penting Demi Keselamatan Anda) *</label>
                <input type="text" id="resAlergi" required placeholder="Contoh: Amoxicillin, Asam Mefenamat, atau tulis 'Tidak Ada'..." />
              </div>
              <div class="form-group full">
                <label for="resKeluhan">Keluhan Utama Gigi / Gejala yang Dialami *</label>
                <textarea id="resKeluhan" rows="3" required placeholder="Jelaskan rasa nyeri, gigi ngilu, tambalan lepas, gusi bengkak, atau kebutuhan estetika gigi Anda..."></textarea>
              </div>
            </div>

            <div style="margin-top:24px; text-align:right;">
              <button type="submit" class="nav-btn btn-primary" style="padding:12px 24px; width:100%; max-width:340px;" id="btnSubmitReservasi">
                <i class="fa-solid fa-paper-plane"></i> Konfirmasi Pendaftaran Antrean
              </button>
            </div>
          </form>
        </div>
      </section>

      <!-- Kontak & Lokasi (Rebranded: Estaka Dental Clinic) -->
      <section class="container animate-swipe-up" id="kontak" aria-label="Kontak dan Lokasi">
        <div class="section-title">
          <h2>Lokasi & Informasi Operasional</h2>
          <p>Klinik gigi modern dan nyaman di pusat kota Makassar dengan fasilitas parkir memadai</p>
        </div>
        <div class="form-grid">
          <div class="glass-card" style="padding:24px;">
            <h3 style="font-size:1.25rem; font-weight:800; margin-bottom:12px; color:var(--primary);">
              <i class="fa-solid fa-location-dot"></i> Estaka Dental Clinic
            </h3>
            <p style="color:var(--text-muted); line-height:1.6; font-size:0.92rem; margin-bottom:14px;">
              Jl. Andi Tonro Blok F No.30, Bongaya, Kec. Tamalate, Kota Makassar, Sulawesi Selatan 90131.<br>
              <strong>Jam Operasional:</strong> Setiap Hari, 08:00 – 21:00 WITA<br>
              <strong>Hotline WhatsApp:</strong> +62 853-3892-2586<br>
              <strong>Email Resmi:</strong> care@estakadental.space<br>
              <strong>Web Resmi:</strong> <a href="<%= seo.baseUrl %>" style="color:var(--primary); font-weight:600; text-decoration:none;"><%= seo.baseUrl %></a>
            </p>
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
              <a href="https://instagram.com/aksharadental" target="_blank" rel="noopener noreferrer" class="nav-btn btn-outline"><i class="fa-brands fa-instagram"></i> Instagram</a>
              <a href="mailto:care@estakadental.space" class="nav-btn btn-outline"><i class="fa-solid fa-envelope"></i> Kirim Email</a>
            </div>
          </div>
          <div class="glass-card" style="padding:8px; overflow:hidden; min-height:260px;">
