      document.getElementById('pwaModal').classList.remove('show');
    }

    function initInlineServiceWorker() {
      window.addEventListener('beforeinstallprompt', function(e) {
        e.preventDefault();
        deferredPwaPrompt = e;
        const btn = document.getElementById('btnInstallPwa');
        if (btn) btn.style.display = 'block';
      });

      if ('serviceWorker' in navigator) {
        try {
          const swBlob = new Blob([
            "self.addEventListener('install', e => self.skipWaiting()); self.addEventListener('activate', e => self.clients.claim());"
          ], { type: 'application/javascript' });
          const swUrl = URL.createObjectURL(swBlob);
          navigator.serviceWorker.register(swUrl).catch(function() {});
        } catch (e) {}
      }
    }

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then(function() {
          deferredPwaPrompt = null;
          closePwaModal();
        });
      } else {
        showToast('Pilih opsi "Add to Home Screen" pada menu peramban Anda.', 'info');
      }
    }
  </script>
