<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title><%= seo.title %></title>
  <meta name="robots" content="noindex, nofollow" />

  <!-- Favicon & Touch Icons -->
  <link rel="icon" type="image/png" href="/img/axalogo.png" />
  <link rel="shortcut icon" href="/img/axalogo.png" />
  <link rel="apple-touch-icon" href="/img/axalogo.png" />

  <!-- External Typography & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Modular Stylesheet -->
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body class="theme-white">

  <!-- Toast Notification Box -->
  <div id="toastBox" class="toast-box" role="status" aria-live="polite"></div>

  <!-- Scroll To Top Button -->
  <button id="scrollToTopBtn" class="scroll-top-btn" onclick="scrollToTop()" title="Kembali ke Atas" aria-label="Kembali ke atas">
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <!-- DevTools Protection Modal -->
  <div class="modal-overlay" id="devtoolsSecurityModal" role="dialog" aria-modal="true" aria-labelledby="secModalTitle">
    <div class="glass-card modal-box" style="background:rgba(15,23,42,0.97); border:2px solid #ef4444; color:#ffffff; text-align:center;">
      <div style="width:64px; height:64px; border-radius:50%; background:rgba(239,68,68,0.2); border:2px solid #ef4444; color:#ef4444; display:flex; align-items:center; justify-content:center; font-size:1.8rem; margin:0 auto 14px;">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h3 id="secModalTitle" style="font-size:1.2rem; font-weight:800; color:#ef4444; margin-bottom:8px;">
        AKSES DEVTOOLS DIBATASI
      </h3>
      <div style="font-size:0.75rem; font-weight:700; color:#cbd5e1; background:rgba(239,68,68,0.25); padding:4px 10px; border-radius:20px; display:inline-block; margin-bottom:12px;">
        PERMENKES NO. 24 TAHUN 2022 — REKAM MEDIS ELEKTRONIK
      </div>
      <p style="font-size:0.84rem; color:#e2e8f0; line-height:1.5; margin-bottom:16px;">
        Fitur inspeksi kode dan pintasan developer tools dinonaktifkan demi menjaga integritas serta kerahasiaan riwayat medis pasien Klinik Akshara Dental Space.
      </p>
      <button class="nav-btn btn-primary" style="background:#ef4444; border:none; padding:10px 20px; margin:0 auto;" onclick="closeDevtoolsSecurityModal()">
        <i class="fa-solid fa-check"></i> Saya Mengerti & Lanjutkan
      </button>
    </div>
  </div>

  <!-- Header Khusus Portal Staf & Dokter -->
  <header class="site-header" role="banner">
    <div class="brand-logo">
      <div class="brand-icon">
        <img src="/img/axalogo.png" alt="Logo Akshara" onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\'fa-solid fa-tooth\'></i>';" />
      </div>
      <div>
        <div class="brand-title">Portal Medis & Admin</div>
        <div class="brand-subtitle">Akshara Dental Space</div>
      </div>
    </div>

    <div class="header-actions">
      <button class="nav-btn btn-outline" id="themeToggleBtn" onclick="toggleTheme()" title="Ubah Tema Warna">
        <i class="fa-solid fa-circle-half-stroke"></i> <span id="themeLabel">Tema Putih</span>
      </button>

      <a href="/" class="nav-btn btn-outline" style="text-decoration:none;" title="Lihat Website Publik">
        <i class="fa-solid fa-globe"></i> <span>Web Utama</span>
      </a>

      <a href="/antrean-tv" target="_blank" class="nav-btn btn-outline" style="text-decoration:none;" title="Buka Monitor Antrean">
        <i class="fa-solid fa-tv"></i> <span>TV Display</span>
      </a>

      <button class="nav-btn btn-outline" style="color:#ef4444; border-color:#ef4444;" onclick="logoutUser()" title="Keluar dari Portal">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> <span>Logout</span>
      </button>
    </div>
  </header>

  <!-- Kontainer Utama Portal Staf -->
  <main class="container animate-swipe-up" style="padding-top:20px;">
    
    <!-- Baris Profil Staf Aktif -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:1px solid var(--glass-border); padding-bottom:14px; flex-wrap:wrap; gap:10px;">
      <div>
        <h2 id="portalGreeting" style="font-size:1.4rem; font-weight:800;">Dashboard Portal Medis</h2>
        <p id="portalRoleBadge" style="color:var(--primary); font-weight:700; font-size:0.85rem;"></p>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="nav-btn btn-outline" onclick="refreshStaffView()"><i class="fa-solid fa-rotate"></i> Refresh Data</button>
      </div>
    </div>

    <!-- Tab Navigasi Berdasarkan Hak Akses Role -->
    <div id="portalNavTabs" style="display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap;"></div>

    <!-- ===================================================================== -->
    <!-- 1. KONTEN MODUL DOKTER GIGI (CPPT, ODONTOGRAM 52 GIGI, E-RESEP, LAB)  -->
    <!-- ===================================================================== -->
    <div id="staffSectionDokter" style="display:none;">
      <div class="form-grid">
        <div class="glass-card" style="padding:20px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h3 style="font-size:1.1rem; font-weight:700;"><i class="fa-solid fa-users"></i> Antrean Pasien Gigi Hari Ini</h3>
            <button class="nav-btn btn-outline" style="padding:4px 8px; font-size:0.75rem;" onclick="loadDoctorQueueData()"><i class="fa-solid fa-rotate"></i> Reload</button>
          </div>
          <div id="doctorQueueList" style="display:flex; flex-direction:column; gap:10px; max-height:520px; overflow-y:auto;"></div>
        </div>

        <div class="glass-card" style="padding:20px;" id="doctorWorkArea">
          <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:12px;"><i class="fa-solid fa-stethoscope"></i> Rekam Medis Gigi, Odontogram, E-Resep & Lab</h3>
          <div id="selectedPatientBadge" style="padding:10px; border-radius:10px; background:var(--badge-bg); font-size:0.85rem; font-weight:700; margin-bottom:14px;">
            Pilih salah satu pasien di kolom antrean untuk memulai pemeriksaan.
          </div>

          <div id="patientAllergyAlert" style="display:none; padding:10px; border-radius:10px; background:#fee2e2; border:1px solid #ef4444; color:#991b1b; font-weight:700; margin-bottom:12px; font-size:0.85rem;">
            <i class="fa-solid fa-triangle-exclamation"></i> ALERGI OBAT: <span id="alertAlergiText"></span>
          </div>

          <!-- ODONTOGRAM 52 ELEMEN INTERAKTIF -->
          <div id="odontogramModule" style="display:none;" class="odontogram-wrapper">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:6px;">
              <span style="font-weight:700; font-size:0.85rem;"><i class="fa-solid fa-tooth"></i> Odontogram Interaktif Dental Space</span>
              <select id="odontogramStatusTool" style="font-size:0.8rem; padding:4px 8px; width:auto;">
                <option value="status-karies">Karies (Merah)</option>
                <option value="status-tambalan">Tambalan (Oranye)</option>
                <option value="status-mahkota">Mahkota (Kuning)</option>
                <option value="status-endo">Endodontik (Ungu)</option>
                <option value="status-hilang">Hilang / Missing (Abu-abu)</option>
                <option value="status-normal">Normal (Bersih)</option>
              </select>
            </div>
            <div style="font-size:0.72rem; font-weight:700; text-align:center; color:var(--text-muted);">Gigi Dewasa Rahang Atas (18-11, 21-28)</div>
            <div class="teeth-row" id="teethAdultUpper"></div>
            <div style="font-size:0.72rem; font-weight:700; text-align:center; color:var(--text-muted);">Gigi Susu / Anak (55-51, 61-65 & 85-81, 71-75)</div>
            <div class="teeth-row" id="teethChildUpper"></div>
            <div class="teeth-row" id="teethChildLower"></div>
            <div style="font-size:0.72rem; font-weight:700; text-align:center; color:var(--text-muted);">Gigi Dewasa Rahang Bawah (48-41, 31-38)</div>
            <div class="teeth-row" id="teethAdultLower"></div>
          </div>

          <!-- Form SOAP -->
          <div class="form-grid" style="margin-bottom:12px;">
            <div class="form-group">
              <label for="cpptTriage">Status Triage</label>
              <select id="cpptTriage">
                <option value="Hijau">Hijau (Non-Gawat Darurat)</option>
                <option value="Kuning">Kuning (Mendesak / Pulpitis Akut)</option>
                <option value="Merah">Merah (Gawat Darurat Dental)</option>
              </select>
            </div>
            <div class="form-group">
              <label for="cpptVital">Tanda Vital (Tekanan Darah / Nadi / Suhu)</label>
              <input type="text" id="cpptVital" placeholder="Contoh: 120/80 mmHg, 78 bpm, 36.5 °C" />
            </div>
          </div>

          <div class="form-group" style="margin-bottom:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <label for="cpptSubjektif">Subjektif (Anamnesa / Keluhan Pasien)</label>
              <button type="button" class="nav-btn btn-outline" style="padding:2px 8px; font-size:0.72rem; min-height:26px;" onclick="toggleSpeechRecognition('cpptSubjektif')">
                <i class="fa-solid fa-microphone" id="micIcon_cpptSubjektif"></i> Dikte Suara (Voice to Text)
              </button>
            </div>
            <textarea id="cpptSubjektif" rows="2" placeholder="Pasien mengeluhkan ngilu pada gigi geraham bawah saat minum dingin..."></textarea>
          </div>

          <div class="form-group" style="margin-bottom:8px;">
            <label for="cpptObjektif">Objektif (Pemeriksaan Klinis & Intraoral)</label>
            <textarea id="cpptObjektif" rows="2" placeholder="Gigi 46 karies profunda, perkusi (+), palpasi (-), sondasi (+)..."></textarea>
          </div>
          
          <div class="form-group" style="margin-bottom:8px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;">
              <label for="cpptAsesmen">Asesmen / Diagnosa Klinis (ICD-10 Gigi)</label>
              <button type="button" class="nav-btn btn-groq" style="padding:5px 12px; font-size:0.75rem; min-height:32px;" onclick="callGroqAiAgent()">
                <i class="fa-solid fa-bolt"></i> <span>Konsultasi Groq AI Agent</span>
              </button>
            </div>
            <textarea id="cpptAsesmen" rows="2" placeholder="K04.0 Pulpitis Ireversibel Gigi 46..."></textarea>
          </div>

          <!-- GROQ AI AGENT CLINICAL BOX -->
          <div id="groqAiAgentBox" style="display:none;" class="groq-agent-box">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; flex-wrap:wrap; gap:6px;">
              <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                <span class="groq-badge"><i class="fa-solid fa-bolt"></i> GROQ LPU AI MEDICAL AGENT</span>
                <select id="doctorGroqQuickModel" onchange="switchDoctorGroqModel(this.value)" style="font-size:0.72rem; font-weight:700; padding:2px 8px; width:auto; background:#fff; border-color:#f97316; height:28px;">
                  <option value="openai/gpt-oss-120b" selected>openai/gpt-oss-120b (Flagship Reasoning)</option>
                  <option value="qwen/qwen3.8-27b">qwen/qwen3.8-27b (High Intelligence)</option>
                  <option value="openai/gpt-oss-20b">openai/gpt-oss-20b (Ultra Cepat)</option>
                  <option value="qwen/qwen3.6-27b">qwen/qwen3.6-27b (Fast Reasoning)</option>
                  <option value="groq/compound">groq/compound (Compound Agent)</option>
                  <option value="groq/compound-mini">groq/compound-mini (Compound Mini)</option>
                </select>
              </div>
              <div style="display:flex; gap:6px;">
                <button type="button" class="nav-btn btn-outline" style="padding:2px 8px; font-size:0.7rem; min-height:26px;" onclick="applyAiDiagnosis()">
                  <i class="fa-solid fa-arrow-turn-down"></i> Terapkan ke Asesmen
                </button>
                <button type="button" class="nav-btn btn-outline" style="padding:2px 8px; font-size:0.7rem; min-height:26px;" onclick="applyAiPlan()">
                  <i class="fa-solid fa-arrow-turn-down"></i> Terapkan ke Plan
                </button>
              </div>
            </div>

            <div id="groqChatContainer" class="groq-chat-history">
              <div class="groq-msg-bubble groq-msg-agent" id="groqPrimaryResult">
                <i class="fa-solid fa-spinner fa-spin"></i> Groq AI Agent sedang menganalisis data klinis gigi...
              </div>
            </div>

            <div style="display:flex; gap:6px; margin-top:8px;">
              <input type="text" id="groqFollowUpInput" placeholder="Tanya lanjutan ke AI Agent (misal: teknik preparasi saluran akar, dosis obat)..." style="padding:8px 12px; font-size:0.82rem;" onkeydown="if(event.key==='Enter'){event.preventDefault();sendGroqFollowUp();}" />
              <button type="button" class="nav-btn btn-groq" style="padding:6px 12px; font-size:0.8rem; height:42px;" onclick="sendGroqFollowUp()">
                <i class="fa-solid fa-paper-plane"></i>
              </button>
            </div>
          </div>

          <div class="form-group" style="margin-bottom:12px;">
            <label for="cpptPlan">Plan / Terapi & Prosedur Tindakan Gigi</label>
            <textarea id="cpptPlan" rows="2" placeholder="Pulpektomi devitalisasi, preparasi biomekanis saluran akar, medikamen intrakanal..."></textarea>
          </div>

          <!-- MODUL E-RESEP OBAT KE APOTEK/FARMASI -->
          <div style="border-top:1.5px solid var(--glass-border); padding-top:14px; margin-bottom:16px;">
            <h4 style="font-size:0.95rem; font-weight:800; color:var(--primary); margin-bottom:10px;">
              <i class="fa-solid fa-prescription"></i> E-Resep Obat ke Farmasi / Apotek
            </h4>
            <div class="form-grid" style="grid-template-columns:2fr 1fr 2fr auto; gap:8px; align-items:flex-end;">
              <div class="form-group">
                <label style="font-size:0.75rem;">Pilih Obat (Dari Master Obat Dental)</label>
                <select id="resepPilihObat" style="padding:8px 10px; font-size:0.85rem;"></select>
              </div>
              <div class="form-group">
                <label style="font-size:0.75rem;">Jumlah</label>
                <input type="number" id="resepJumlahObat" value="10" min="1" style="padding:8px 10px; font-size:0.85rem;" />
              </div>
              <div class="form-group">
                <label style="font-size:0.75rem;">Aturan Pakai / Signa</label>
                <input type="text" id="resepSignaObat" placeholder="Contoh: 3 x 1 tablet sesudah makan" style="padding:8px 10px; font-size:0.85rem;" />
              </div>
              <button type="button" class="nav-btn btn-primary" onclick="tambahItemResep()" style="padding:8px 14px; font-size:0.82rem; height:42px;">
                <i class="fa-solid fa-plus"></i> Tambah
              </button>
            </div>

            <!-- Tabel Rincian Obat -->
            <div style="margin-top:10px; overflow-x:auto;">
              <table style="width:100%; border-collapse:collapse; font-size:0.82rem;">
                <thead>
                  <tr style="border-bottom:1.5px solid var(--glass-border); text-align:left;">
                    <th style="padding:6px;">Nama Obat</th>
                    <th style="padding:6px; text-align:center;">Qty</th>
                    <th style="padding:6px;">Aturan Pakai</th>
                    <th style="padding:6px; text-align:center;">Aksi</th>
                  </tr>
                </thead>
                <tbody id="resepTableBody">
                  <tr><td colspan="4" style="padding:8px; text-align:center; color:var(--text-muted);">Belum ada obat yang ditambahkan.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- MODUL ORDER RUJUKAN LABORATORIUM / RADIOLOGI GIGI -->
          <div style="border-top:1.5px solid var(--glass-border); padding-top:14px; margin-bottom:16px;">
            <h4 style="font-size:0.95rem; font-weight:800; color:#059669; margin-bottom:10px;">
              <i class="fa-solid fa-flask-vial"></i> Order Rujukan Uji Lab & Radiologi Dental
            </h4>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:8px; font-size:0.82rem;">
              <label style="display:flex; align-items:center; gap:6px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="labTests" value="Dental Panoramic 2D" style="width:auto;" /> Rontgen Panoramic 2D
              </label>
              <label style="display:flex; align-items:center; gap:6px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="labTests" value="Rontgen Periapikal" style="width:auto;" /> Rontgen Periapikal Gigi
              </label>
              <label style="display:flex; align-items:center; gap:6px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="labTests" value="Darah Lengkap (CBC)" style="width:auto;" /> Darah Lengkap (CBC)
              </label>
              <label style="display:flex; align-items:center; gap:6px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="labTests" value="Bleeding & Clotting Time" style="width:auto;" /> Bleeding / Clotting Time
              </label>
              <label style="display:flex; align-items:center; gap:6px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="labTests" value="Gula Darah Sewaktu (GDS)" style="width:auto;" /> Gula Darah Sewaktu (GDS)
              </label>
              <label style="display:flex; align-items:center; gap:6px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="labTests" value="Swab Kultur Bakteri Oral" style="width:auto;" /> Kultur Bakteri Oral
              </label>
            </div>
          </div>

          <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end;">
            <button class="nav-btn btn-outline" onclick="openDocGeneratorModal()"><i class="fa-solid fa-file-pdf"></i> Terbitkan Surat Keterangan</button>
            <button class="nav-btn btn-primary" onclick="submitCppt()"><i class="fa-solid fa-floppy-disk"></i> Simpan CPPT & Kirim Resep/Lab</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 2. KONTEN MODUL FARMASI / APOTEK                                      -->
    <!-- ===================================================================== -->
    <div id="staffSectionFarmasi" style="display:none;">
      <div class="glass-card" style="padding:20px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
          <h3 style="font-size:1.15rem; font-weight:800;"><i class="fa-solid fa-prescription-bottle-medical"></i> Antrean E-Resep Obat Pasien Masuk</h3>
          <button class="nav-btn btn-outline" style="padding:4px 8px; font-size:0.75rem;" onclick="loadPharmacyOrders()"><i class="fa-solid fa-rotate"></i> Reload</button>
        </div>
        <div id="pharmacyOrdersList" style="display:flex; flex-direction:column; gap:12px;"></div>
      </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 3. KONTEN MODUL LABORATORIUM & RADIOLOGI                              -->
    <!-- ===================================================================== -->
    <div id="staffSectionLab" style="display:none;">
      <div class="glass-card" style="padding:20px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
          <h3 style="font-size:1.15rem; font-weight:800;"><i class="fa-solid fa-vial-circle-check"></i> Order Rujukan Uji Laboratorium & Rontgen</h3>
          <button class="nav-btn btn-outline" style="padding:4px 8px; font-size:0.75rem;" onclick="loadLabOrders()"><i class="fa-solid fa-rotate"></i> Reload</button>
        </div>
        <div id="labOrdersList" style="display:flex; flex-direction:column; gap:12px;"></div>
      </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 4. KONTEN MODUL KASIR POS & REKONSILIASI SHIFT                        -->
    <!-- ===================================================================== -->
    <div id="staffSectionKasir" style="display:none;">
      <div class="form-grid">
        <div class="glass-card" style="padding:20px;">
          <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:10px;"><i class="fa-solid fa-cash-register"></i> Status Shift Kasir</h3>
          <div id="posShiftStatusBox" style="padding:12px; border-radius:10px; background:var(--badge-bg); margin-bottom:14px; font-size:0.88rem;">
            Memeriksa status shift kasir...
          </div>
          <div id="posShiftActionArea"></div>
        </div>

        <div class="glass-card" style="padding:20px;">
          <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:10px;"><i class="fa-solid fa-receipt"></i> Transaksi Kasir Medis Gigi</h3>
          <div style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
            <input type="text" id="posBillingSearch" placeholder="Ketik Kode Antrean / No RM..." style="flex:1; min-width:180px;" />
            <button class="nav-btn btn-primary" onclick="loadBillingDetails()"><i class="fa-solid fa-magnifying-glass"></i> Cari Tagihan</button>
          </div>

          <div id="billingSummaryArea" style="display:none;">
            <div id="billingPatientInfo" style="font-weight:700; margin-bottom:8px; font-size:0.9rem;"></div>
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem; margin-bottom:12px;">
              <thead>
                <tr style="border-bottom:1.5px solid var(--glass-border); text-align:left;">
                  <th style="padding:6px;">Item Tagihan</th>
                  <th style="padding:6px; text-align:center;">Qty</th>
                  <th style="padding:6px; text-align:right;">Subtotal</th>
                </tr>
              </thead>
              <tbody id="billingTableBody"></tbody>
            </table>

            <div class="form-grid" style="margin-bottom:12px;">
              <div class="form-group">
                <label for="posMetodeBayar">Metode Pembayaran</label>
                <select id="posMetodeBayar" onchange="calculateChange()">
                  <option value="Tunai">Tunai</option>
                  <option value="QRIS">QRIS Dinamis / Statis</option>
                  <option value="Debit">Kartu Debit / EDC</option>
                  <option value="Transfer">Transfer Bank</option>
                  <option value="Asuransi">Klaim Asuransi</option>
                  <option value="Split">Split Pay</option>
                </select>
              </div>
              <div class="form-group">
                <label for="posNominalBayar">Nominal Bayar (Rp)</label>
                <input type="number" id="posNominalBayar" oninput="calculateChange()" placeholder="Jumlah uang..." />
              </div>
            </div>

            <div style="display:flex; justify-content:space-between; font-weight:800; font-size:1.05rem; margin-bottom:14px; border-top:1px solid var(--glass-border); padding-top:8px;">
              <div>Kembalian:</div>
              <div id="posKembalianText" style="color:#059669;">Rp 0</div>
            </div>

            <div style="display:flex; gap:8px; justify-content:flex-end;">
