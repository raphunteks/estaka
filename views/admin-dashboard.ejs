    function openDocGeneratorModal() {
      if (!activeDoctorPatient) {
        showToast('Pilih pasien terlebih dahulu!', 'error');
        return;
      }
      document.getElementById('docModal').classList.add('show');
    }
    function closeDocModal() {
      document.getElementById('docModal').classList.remove('show');
    }

    function submitGenerateDoc() {
      const payload = {
        jenisDokumen: document.getElementById('docTypeSelect').value,
        nomorRm: activeDoctorPatient.nomorRm,
        namaPasien: activeDoctorPatient.namaPasien,
        kodeAntrean: activeDoctorPatient.kodeAntrean,
        dokterId: currentUser ? (currentUser.dokterId || currentUser.userId) : 'DOC-001',
        namaDokter: currentUser ? currentUser.fullName : 'drg. Hj. Kurniawaty, Sp.KG',
        diagnosa: document.getElementById('docDiagnosa').value,
        keterangan: document.getElementById('docKeterangan').value,
        user: currentUser ? currentUser.username : 'DOKTER'
      };

      runApi('generateMedicalDoc', payload)
        .then(function(res) {
          closeDocModal();
          if (res && res.status === 'success') {
            showToast('Dokumen ' + res.nomorSurat + ' terbit!', 'success');
            if (res.fileUrl) window.open(res.fileUrl, '_blank');
          }
        });
    }

    // =========================================================================
    // KASIR POS & REKONSILIASI SHIFT
    // =========================================================================

    function checkPosShiftStatus() {
      const box = document.getElementById('posShiftStatusBox');
      const action = document.getElementById('posShiftActionArea');
      const kasirId = currentUser ? currentUser.fullName : 'Kasir Utama';

      runApi('checkActiveShift', { kasirId: kasirId })
        .then(function(res) {
          if (res && res.hasActiveShift) {
            currentShift = res.shift;
            box.innerHTML = '<strong>Shift Aktif:</strong> ' + currentShift.shiftId + ' | Modal Awal: Rp ' + currentShift.modalAwal.toLocaleString();
            action.innerHTML = '<button class="nav-btn btn-outline" style="color:#ef4444; border-color:#ef4444; width:100%; justify-content:center;" onclick="openCloseShiftModal()"><i class="fa-solid fa-lock"></i> Tutup Shift (Z-Report)</button>';
          } else {
            currentShift = null;
            box.innerHTML = 'Tidak ada shift aktif. Silakan buka shift baru.';
            action.innerHTML = '<div style="display:flex; flex-direction:column; gap:8px;">' +
              '<input type="number" id="newShiftFloat" placeholder="Modal Awal Laci Kasir Rp..." />' +
              '<button class="nav-btn btn-primary" style="justify-content:center;" onclick="openNewShift()"><i class="fa-solid fa-door-open"></i> Buka Shift Baru</button>' +
            '</div>';
          }
        });
    }

    function openNewShift() {
      const modalAwal = document.getElementById('newShiftFloat').value;
      if (!modalAwal) {
        showToast('Masukkan modal awal kasir!', 'error');
        return;
      }
      runApi('openCashierShift', {
        kasirId: currentUser ? currentUser.userId : 'USR-007',
        namaKasir: currentUser ? currentUser.fullName : 'Kasir',
        shiftKerja: 'Pagi',
        modalAwal: modalAwal
      }).then(function(res) {
        if (res && res.status === 'success') {
          showToast('Shift berhasil dibuka!', 'success');
          checkPosShiftStatus();
        }
      });
    }

    function openCloseShiftModal() {
      document.getElementById('closeShiftModal').classList.add('show');
    }
    function closeCloseShiftModal() {
      document.getElementById('closeShiftModal').classList.remove('show');
    }

    function submitCloseShift() {
      const actualCash = document.getElementById('closeShiftActualCash').value;
      const notes = document.getElementById('closeShiftNotes').value;
      if (!actualCash) {
        showToast('Masukkan total uang tunai fisik di laci!', 'error');
        return;
      }

      runApi('closeCashierShift', {
        shiftId: currentShift.shiftId,
        actualCash: actualCash,
        catatan: notes || 'Tutup shift reguler',
        user: currentUser ? currentUser.username : 'KASIR'
      }).then(function(res) {
        closeCloseShiftModal();
        if (res && res.status === 'success') {
          const z = res.zReport;
          showToast('Shift ditutup: ' + z.statusSelisih + ' (Selisih: Rp ' + z.selisih.toLocaleString() + ')', 'success');
          checkPosShiftStatus();
        }
      });
    }

    function loadBillingDetails() {
      const q = document.getElementById('posBillingSearch').value.trim();
      if (!q) return;

      runApi('getBillingDetails', { kodeAntrean: q, nomorRm: q })
        .then(function(res) {
          if (res && res.status === 'success') {
            activeBilling = res;
            document.getElementById('billingSummaryArea').style.display = 'block';
            document.getElementById('billingPatientInfo').innerText = 'Pasien: ' + res.namaPasien + ' (' + res.nomorRm + ') | No Antrean: ' + res.kodeAntrean;

            let html = '';
            for (let i = 0; i < res.items.length; i++) {
              const item = res.items[i];
              html += '<tr style="border-bottom:1px solid var(--glass-border);">' +
                '<td style="padding:6px;">' + item.nama + '</td>' +
                '<td style="padding:6px; text-align:center;">' + item.jumlah + '</td>' +
                '<td style="padding:6px; text-align:right;">Rp ' + item.subtotal.toLocaleString() + '</td>' +
              '</tr>';
            }
            html += '<tr style="font-weight:800; border-top:1.5px solid var(--glass-border);">' +
              '<td colspan="2" style="padding:8px;">TOTAL AKHIR</td>' +
              '<td style="padding:8px; text-align:right;">Rp ' + res.subtotal.toLocaleString() + '</td>' +
            '</tr>';
            document.getElementById('billingTableBody').innerHTML = html;
            document.getElementById('posNominalBayar').value = res.subtotal;
            calculateChange();
          }
        });
    }

    function calculateChange() {
      if (!activeBilling) return;
      const bayar = parseInt(document.getElementById('posNominalBayar').value) || 0;
      const kembali = Math.max(0, bayar - activeBilling.subtotal);
      document.getElementById('posKembalianText').innerText = 'Rp ' + kembali.toLocaleString();
    }

    function submitPosPayment() {
      if (!activeBilling) return;
      const payload = {
        shiftId: currentShift ? currentShift.shiftId : '',
        kodeAntrean: activeBilling.kodeAntrean,
        nomorRm: activeBilling.nomorRm,
        items: activeBilling.items,
        subtotal: activeBilling.subtotal,
        diskon: 0,
        totalAkhir: activeBilling.subtotal,
        metodeBayar: document.getElementById('posMetodeBayar').value,
        nominalBayar: parseInt(document.getElementById('posNominalBayar').value) || activeBilling.subtotal,
        nominalKembali: Math.max(0, (parseInt(document.getElementById('posNominalBayar').value) || activeBilling.subtotal) - activeBilling.subtotal),
        kasirId: currentUser ? currentUser.userId : 'KASIR'
      };

      runApi('processPayment', payload)
        .then(function(res) {
          if (res && res.status === 'success') {
            showToast('Pembayaran Berhasil! No: ' + res.transaksiId, 'success');
            document.getElementById('billingSummaryArea').style.display = 'none';
          }
        });
    }

    function printThermalReceipt() {
      window.print();
    }

    // =========================================================================
    // SUPER ADMIN: GROQ, GEMINI, ANALYTICS & WEB CONTENT SETTINGS
    // =========================================================================

    function loadAdminSettingsAndAnalytics() {
      runApi('getSystemSettings', { adminUserId: currentUser ? currentUser.userId : 'ADMIN' })
        .then(function(res) {
          if (res && res.status === 'success' && res.settings) {
            const s = res.settings;

            if (s.GROQ_API_KEY && !s.GROQ_API_KEY.includes('***')) {
              systemGroqKey = s.GROQ_API_KEY;
              localStorage.setItem('akshara_groq_key', systemGroqKey);
            }
            const groqInput = document.getElementById('adminGroqKeyInput');
            if (groqInput) groqInput.value = systemGroqKey || s.GROQ_API_KEY || '';

            if (s.GROQ_MODEL && !s.GROQ_MODEL.includes('orpheus')) {
              systemGroqModel = s.GROQ_MODEL;
              document.getElementById('adminGroqModelSelect').value = systemGroqModel;
            }
            if (s.GROQ_TTS_MODEL) systemTtsModel = s.GROQ_TTS_MODEL;
            if (s.GROQ_TTS_VOICE) systemTtsVoice = s.GROQ_TTS_VOICE;

            const ttsModelSel = document.getElementById('adminTtsModelSelect');
            if (ttsModelSel) ttsModelSel.value = systemTtsModel;
            const ttsVoiceSel = document.getElementById('adminTtsVoicePersona');
            if (ttsVoiceSel) ttsVoiceSel.value = systemTtsVoice;

            if (s.GEMINI_API_KEY) {
              document.getElementById('adminGeminiKeyInput').value = s.GEMINI_API_KEY;
            }

            if (s.KLINIK_NAMA) document.getElementById('webNamaKlinik').value = s.KLINIK_NAMA;
            if (s.KLINIK_SLOGAN) document.getElementById('webSloganKlinik').value = s.KLINIK_SLOGAN;
            if (s.KLINIK_ALAMAT) document.getElementById('webAlamatKlinik').value = s.KLINIK_ALAMAT;
            if (s.KLINIK_TELEPON) document.getElementById('webTeleponWa').value = s.KLINIK_TELEPON;
            if (s.KLINIK_JAM_OPERASIONAL) document.getElementById('webJamOperasional').value = s.KLINIK_JAM_OPERASIONAL;
            if (s.KLINIK_EMAIL) document.getElementById('webEmailKlinik').value = s.KLINIK_EMAIL;
            if (s.KLINIK_INSTAGRAM) document.getElementById('webInstagramUrl').value = s.KLINIK_INSTAGRAM;
            if (s.KLINIK_GMAPS_EMBED) document.getElementById('webGmapsEmbedUrl').value = s.KLINIK_GMAPS_EMBED;
            if (s.KLINIK_FOOTER_NOTE) document.getElementById('webFooterNote').value = s.KLINIK_FOOTER_NOTE;
          }
        });

      runApi('getAnalytics', {})
        .then(function(res) {
          if (res && res.status === 'success') {
            const grid = document.getElementById('adminAnalyticsGrid');
            grid.innerHTML = '<div style="padding:12px; border-radius:10px; background:var(--badge-bg); text-align:center;">' +
              '<div style="font-size:1.6rem; font-weight:800; color:var(--primary);">' + res.totalPasien + '</div>' +
              '<div style="font-size:0.75rem; color:var(--text-muted);">Pasien Hari Ini</div>' +
            '</div>' +
            '<div style="padding:12px; border-radius:10px; background:var(--badge-bg); text-align:center;">' +
              '<div style="font-size:1.6rem; font-weight:800; color:#059669;">Rp ' + res.totalOmset.toLocaleString() + '</div>' +
              '<div style="font-size:0.75rem; color:var(--text-muted);">Omset Kasir</div>' +
            '</div>';
          }
        });

      runApi('getAuditLogs', { page: 1, limit: 10 })
        .then(function(res) {
          if (res && res.status === 'success') {
            const tbody = document.getElementById('adminAuditTableBody');
            let html = '';
            for (let i = 0; i < res.logs.length; i++) {
              const l = res.logs[i];
              html += '<tr style="border-bottom:1px solid var(--glass-border);">' +
                '<td style="padding:6px; font-size:0.75rem;">' + l.timestamp + '</td>' +
                '<td style="padding:6px; font-weight:700;">' + l.user + '</td>' +
                '<td style="padding:6px; color:var(--primary);">' + l.aksi + '</td>' +
                '<td style="padding:6px;">' + l.modul + '</td>' +
              '</tr>';
            }
            tbody.innerHTML = html;
          }
        });
    }

    function togglePasswordEye(inputId) {
      const el = document.getElementById(inputId);
      el.type = el.type === 'password' ? 'text' : 'password';
    }

    function syncAdminGroqModel(m) {
      systemGroqModel = m;
      localStorage.setItem('akshara_groq_model', m);
    }

    function syncTtsSettingsFromAdmin(modelName, voiceName) {
      systemTtsModel = modelName;
      systemTtsVoice = voiceName;
      localStorage.setItem('akshara_tts_model', modelName);
      localStorage.setItem('akshara_tts_voice', voiceName);
    }

    function testGroqConnection() {
      const rawInput = document.getElementById('adminGroqKeyInput').value.trim();
      let k = rawInput || systemGroqKey;
      let m = document.getElementById('adminGroqModelSelect').value;

      if (!k) {
        showToast('Ketik GROQ_API_KEY terlebih dahulu!', 'error');
        return;
      }

      showToast('Menguji koneksi chat ke Groq LPU...', 'groq');

      fetch('https://api.groq.com/openai/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + k
        },
        body: JSON.stringify({
          model: m,
          messages: [{ role: 'user', content: 'Ping test' }],
          max_tokens: 10
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data && data.choices && data.choices[0]) {
          showToast('Koneksi Chat Groq Aktif & Sukses (' + m + ')!', 'success');
          systemGroqKey = k;
          localStorage.setItem('akshara_groq_key', k);
        } else {
          showToast('Groq Error: ' + (data.error ? data.error.message : 'Koneksi gagal'), 'error');
        }
      })
      .catch(err => showToast('Gagal terhubung: ' + err.toString(), 'error'));
    }

    function testQueueVoiceAnnouncement() {
      showToast('Menguji audio speech Groq Orpheus...', 'groq');
      const model = document.getElementById('adminTtsModelSelect').value;
      const voice = document.getElementById('adminTtsVoicePersona').value;

      fetch('/api/groq/tts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: model,
          voice: voice,
          input: 'Panggilan nomor antrean A N T 1. Silakan masuk ke ruang periksa poli gigi spesialis.'
        })
      })
      .then(res => {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.blob();
      })
      .then(blob => {
        const audio = new Audio(URL.createObjectURL(blob));
        audio.play();
        showToast('Suara AI Orpheus (' + voice + ') berhasil diputar.', 'success');
      })
      .catch(e => {
        const key = systemGroqKey || document.getElementById('adminGroqKeyInput').value.trim();
        if (key) {
          fetch('https://api.groq.com/openai/v1/audio/speech', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + key,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              model: model,
              voice: voice,
              response_format: 'wav',
              input: 'Panggilan nomor antrean A N T 1. Silakan masuk ke ruang periksa.'
            })
          })
          .then(r => r.blob())
          .then(b => {
            const a = new Audio(URL.createObjectURL(b));
            a.play();
            showToast('Suara AI Orpheus (' + voice + ') diputar via direct Groq.', 'success');
          })
          .catch(err => showToast('Gagal memutar audio TTS: ' + err.message, 'error'));
        } else {
          showToast('Gagal memutar TTS: ' + e.message, 'error');
        }
      });
    }

    function saveGroqSettings() {
      const k = document.getElementById('adminGroqKeyInput').value.trim() || systemGroqKey;
      const m = document.getElementById('adminGroqModelSelect').value;
      const ttsM = document.getElementById('adminTtsModelSelect').value;
      const ttsV = document.getElementById('adminTtsVoicePersona').value;

      if (k) {
        systemGroqKey = k;
        localStorage.setItem('akshara_groq_key', k);
      }
      systemGroqModel = m;
      systemTtsModel = ttsM;
      systemTtsVoice = ttsV;
      localStorage.setItem('akshara_groq_model', m);
      localStorage.setItem('akshara_tts_model', ttsM);
      localStorage.setItem('akshara_tts_voice', ttsV);

      runApi('updateSystemSettings', { adminUserId: currentUser ? currentUser.userId : 'ADMIN', configKey: 'GROQ_API_KEY', configValue: k })
        .then(() => runApi('updateSystemSettings', { adminUserId: currentUser ? currentUser.userId : 'ADMIN', configKey: 'GROQ_MODEL', configValue: m }))
        .then(() => runApi('updateSystemSettings', { adminUserId: currentUser ? currentUser.userId : 'ADMIN', configKey: 'GROQ_TTS_MODEL', configValue: ttsM }))
        .then(() => runApi('updateSystemSettings', { adminUserId: currentUser ? currentUser.userId : 'ADMIN', configKey: 'GROQ_TTS_VOICE', configValue: ttsV }))
        .then(() => showToast('Konfigurasi Groq AI & TTS berhasil disimpan!', 'success'));
    }

    function saveGeminiSettings() {
      const k = document.getElementById('adminGeminiKeyInput').value.trim();
      runApi('updateSystemSettings', {
        adminUserId: currentUser ? currentUser.userId : 'ADMIN',
        configKey: 'GEMINI_API_KEY',
        configValue: k
      }).then(res => {
        if (res && res.status === 'success') showToast('GEMINI_API_KEY berhasil disimpan!', 'success');
      });
    }

    // =========================================================================
    // HANDLER SIMPAN PENGATURAN KONTEN WEBSITE (SUPER ADMIN)
    // =========================================================================

    function handleSaveWebSettings(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSaveWebSettings');
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';

      const configs = [
        { key: 'KLINIK_NAMA', val: document.getElementById('webNamaKlinik').value.trim() },
        { key: 'KLINIK_SLOGAN', val: document.getElementById('webSloganKlinik').value.trim() },
        { key: 'KLINIK_ALAMAT', val: document.getElementById('webAlamatKlinik').value.trim() },
        { key: 'KLINIK_TELEPON', val: document.getElementById('webTeleponWa').value.trim() },
        { key: 'KLINIK_JAM_OPERASIONAL', val: document.getElementById('webJamOperasional').value.trim() },
        { key: 'KLINIK_EMAIL', val: document.getElementById('webEmailKlinik').value.trim() },
        { key: 'KLINIK_INSTAGRAM', val: document.getElementById('webInstagramUrl').value.trim() },
        { key: 'KLINIK_GMAPS_EMBED', val: document.getElementById('webGmapsEmbedUrl').value.trim() },
        { key: 'KLINIK_FOOTER_NOTE', val: document.getElementById('webFooterNote').value.trim() }
      ];

      const adminId = currentUser ? currentUser.userId : 'SUPER_ADMIN';

      Promise.all(configs.map(item => runApi('updateSystemSettings', { adminUserId: adminId, configKey: item.key, configValue: item.val })))
        .then(function() {
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Simpan Pengaturan Konten Website';
          showToast('Seluruh data konten website berhasil diperbarui ke database!', 'success');
        })
        .catch(function(err) {
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Simpan Pengaturan Konten Website';
          showToast('Gagal menyimpan: ' + err.toString(), 'error');
        });
    }
  </script>
