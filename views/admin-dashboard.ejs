    function callGroqAiAgent() {
      const s = document.getElementById('cpptSubjektif').value.trim();
      const o = document.getElementById('cpptObjektif').value.trim();
      const vital = document.getElementById('cpptVital').value.trim();
      
      if (!s && !o) {
