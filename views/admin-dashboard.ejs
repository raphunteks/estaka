      } else if (role === 'Kasir') {
        html += '<button class="tab-btn active" onclick="switchStaffSection(\'kasir\')"><i class="fa-solid fa-cash-register"></i> Kasir & POS</button>';
        switchStaffSection('kasir');
        checkPosShiftStatus();
      } else if (role === 'Admin') {
        html += '<button class="tab-btn active" onclick="switchStaffSection(\'admin\')"><i class="fa-solid fa-gear"></i> Super Admin</button>';
        html += '<button class="tab-btn" onclick="switchStaffSection(\'dokter\')"><i class="fa-solid fa-tooth"></i> Preview Dokter Gigi</button>';
        html += '<button class="tab-btn" onclick="switchStaffSection(\'farmasi\')"><i class="fa-solid fa-prescription"></i> Farmasi</button>';
        html += '<button class="tab-btn" onclick="switchStaffSection(\'lab\')"><i class="fa-solid fa-flask-vial"></i> Lab & Rontgen</button>';
        html += '<button class="tab-btn" onclick="switchStaffSection(\'kasir\')"><i class="fa-solid fa-cash-register"></i> Kasir POS</button>';
        switchStaffSection('admin');
        loadAdminSettingsAndAnalytics();
      }
      container.innerHTML = html;
    }

    function switchStaffSection(sec) {
      document.getElementById('staffSectionDokter').style.display = sec === 'dokter' ? 'block' : 'none';
      document.getElementById('staffSectionFarmasi').style.display = sec === 'farmasi' ? 'block' : 'none';
      document.getElementById('staffSectionLab').style.display = sec === 'lab' ? 'block' : 'none';
      document.getElementById('staffSectionKasir').style.display = sec === 'kasir' ? 'block' : 'none';
      document.getElementById('staffSectionAdmin').style.display = sec === 'admin' ? 'block' : 'none';

      if (sec === 'dokter') loadDoctorQueueData();
      if (sec === 'farmasi') loadPharmacyOrders();
      if (sec === 'lab') loadLabOrders();
      if (sec === 'kasir') checkPosShiftStatus();
      if (sec === 'admin') loadAdminSettingsAndAnalytics();
