  <script>
    let lastSecurityAlertTime = 0;

    function triggerDevtoolsSecurityAlert(reason) {
      const now = Date.now();
      if (now - lastSecurityAlertTime < 2500) return;
      lastSecurityAlertTime = now;

      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.35);
      } catch (e) {}

      const modal = document.getElementById('devtoolsSecurityModal');
      if (modal) modal.classList.add('show');
    }

    function closeDevtoolsSecurityModal() {
      const modal = document.getElementById('devtoolsSecurityModal');
      if (modal) modal.classList.remove('show');
    }

    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
      triggerDevtoolsSecurityAlert('Context menu blocked');
      return false;
    });

    document.addEventListener('keydown', function(e) {
      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
      const cmdOrCtrl = isMac ? e.metaKey : e.ctrlKey;

      if (
        e.keyCode === 123 ||
        (cmdOrCtrl && e.shiftKey && (e.keyCode === 73 || e.keyCode === 74 || e.keyCode === 67)) ||
        (cmdOrCtrl && (e.keyCode === 85 || e.keyCode === 83))
      ) {
        e.preventDefault();
        triggerDevtoolsSecurityAlert('DevTools shortcut detected');
        return false;
      }
    });

    setInterval(function() {
      console.clear();
    }, 4000);

    // DUAL-MODE API CLIENT: Express Local/Redis Router -> Google Apps Script Fallback
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbzZ8HVyql76ZZbVY7qk8HISf9h8d8xfs6zb4NlrjUZu_MkEYlZMLbjoS300_ap80h-e/exec";

    function runApi(actionName, payloadData) {
      return new Promise(function(resolve, reject) {
        fetch('/api/router', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: actionName, payload: payloadData || {} })
        })
        .then(function(res) {
          if (res.ok) return res.json();
          throw new Error('Local router HTTP ' + res.status);
        })
        .then(function(data) { resolve(data); })
        .catch(function(localErr) {
          fetch(GAS_API_URL, {
            method: 'POST',
            body: JSON.stringify({ action: actionName, payload: payloadData || {} })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) { resolve(data); })
          .catch(function(gasErr) { reject(localErr); });
        });
      });
    }

    // STATE VARIABLES
    let currentUser = null;
    let activeDoctorPatient = null;
    let masterObatList = [];
    const resepItems = [];
    const odontogramState = {};
    let groqConversation = [];
    let currentShift = null;
    let activeBilling = null;
    
    // PERSISTENT GROQ SETTINGS
    let systemGroqKey = localStorage.getItem('akshara_groq_key') || '';
    let systemGroqModel = localStorage.getItem('akshara_groq_model') || 'openai/gpt-oss-120b';
    let systemTtsModel = localStorage.getItem('akshara_tts_model') || 'canopylabs/orpheus-arabic-saudi';
    let systemTtsVoice = localStorage.getItem('akshara_tts_voice') || 'abdullah';

    window.addEventListener('DOMContentLoaded', function() {
      initTheme();
      initOdontogramGrid();
      initScrollToTopListener();
      loadMasterObatData();
      verifyAuthSession();
    });

    function verifyAuthSession() {
      const stored = localStorage.getItem('akshara_user');
      if (!stored) {
        alert('Sesi masuk tidak ditemukan. Silakan login terlebih dahulu.');
        window.location.href = '/';
        return;
      }

      try {
        currentUser = JSON.parse(stored);
        document.getElementById('portalGreeting').innerText = 'Selamat Datang, ' + currentUser.fullName;
        document.getElementById('portalRoleBadge').innerText = 'Hak Akses: ' + currentUser.role + ' (' + (currentUser.dokterId || currentUser.poliklinikId) + ')';
        setupPortalTabsByRole(currentUser.role);
      } catch (e) {
        localStorage.removeItem('akshara_user');
        window.location.href = '/';
      }
    }

    function showToast(msg, type) {
      const box = document.getElementById('toastBox');
      box.className = 'toast-box ' + (type || 'info');
      box.innerText = msg;
      box.style.display = 'block';
      setTimeout(function() { box.style.display = 'none'; }, 4000);
    }

    function initScrollToTopListener() {
      const btn = document.getElementById('scrollToTopBtn');
      window.addEventListener('scroll', function() {
        if (window.pageYOffset > 280) {
          btn.classList.add('show');
        } else {
          btn.classList.remove('show');
        }
      });
    }

    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function initTheme() {
      const savedTheme = localStorage.getItem('akshara_theme') || 'theme-white';
      document.body.className = savedTheme;
      updateThemeLabel(savedTheme);
    }

    function toggleTheme() {
      const current = document.body.className;
      const next = current === 'theme-white' ? 'theme-blue' : 'theme-white';
      document.body.className = next;
      localStorage.setItem('akshara_theme', next);
      updateThemeLabel(next);
      showToast('Tema diubah ke: ' + (next === 'theme-white' ? 'White Higienis' : 'Blue Cyan Soft'), 'info');
    }

    function updateThemeLabel(theme) {
      const label = document.getElementById('themeLabel');
      if (label) {
        label.innerText = theme === 'theme-white' ? 'Tema Putih' : 'Tema Biru';
      }
    }

    function setupPortalTabsByRole(role) {
      const container = document.getElementById('portalNavTabs');
      let html = '';

      if (role === 'Dokter') {
        html += '<button class="tab-btn active" onclick="switchStaffSection(\'dokter\')"><i class="fa-solid fa-user-doctor"></i> Pelayanan Medis Gigi & CPPT</button>';
