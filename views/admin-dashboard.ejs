        return;
      }

      const box = document.getElementById('groqAiAgentBox');
      const chatContainer = document.getElementById('groqChatContainer');
      box.style.display = 'block';

      const odontoSummary = Object.keys(odontogramState).map(k => 'Gigi ' + k + ' (' + odontogramState[k].replace('status-', '') + ')').join(', ') || 'Belum ada data';
      const patientInfo = activeDoctorPatient ? (activeDoctorPatient.namaPasien + ', Alergi: ' + activeDoctorPatient.alergi) : 'Pasien Umum';

      const clinicalPrompt = 'DATA KLINIS PASIEN DENTAL:\n' +
        '- Identitas: ' + patientInfo + '\n' +
        '- Tanda Vital: ' + (vital || 'Normal') + '\n' +
        '- Subjektif: ' + (s || '-') + '\n' +
        '- Objektif: ' + (o || '-') + '\n' +
        '- Odontogram: ' + odontoSummary + '\n\n' +
        'Bantu tegakkan diferensial diagnosa ICD-10 gigi, rancang rencana terapi komprehensif (konservasi/endodontik/estetika), dan peringatan kontraindikasi obat.';

      let chatModel = systemGroqModel || 'openai/gpt-oss-120b';

      chatContainer.innerHTML = '<div class="groq-msg-bubble groq-msg-agent" id="groqPrimaryResult">' +
        '<i class="fa-solid fa-bolt fa-spin" style="color:#ea580c;"></i> Menganalisis data klinis gigi via Groq LPU...' +
      '</div>';

      groqConversation = [
        {
          role: 'system',
          content: 'Anda adalah Asisten Medis AI & Odontolog Cerdas Klinik Akshara Dental Space Makassar.'
        },
        { role: 'user', content: clinicalPrompt }
      ];

      executeGroqRequest(groqConversation, function(err, responseText) {
        if (err) {
          chatContainer.innerHTML = '<div class="groq-msg-bubble groq-msg-agent" style="color:#dc2626;">Error: ' + err + '</div>';
          return;
        }

        extractAiFields(responseText);
        chatContainer.innerHTML = '<div class="groq-msg-bubble groq-msg-agent">' +
          '<div style="font-weight:800; color:#ea580c; margin-bottom:6px;"><i class="fa-solid fa-clipboard-check"></i> Rekomendasi Terapi (' + chatModel + '):</div>' +
          '<div style="white-space:pre-wrap;">' + escapeHtml(responseText) + '</div>' +
        '</div>';
        showToast('Analisis Groq LPU selesai!', 'groq');
      });
    }

    function sendGroqFollowUp() {
      const input = document.getElementById('groqFollowUpInput');
      const q = input.value.trim();
      if (!q) return;

      const chatContainer = document.getElementById('groqChatContainer');
      chatContainer.innerHTML += '<div class="groq-msg-bubble groq-msg-user">' + escapeHtml(q) + '</div>';
      input.value = '';

      const loadingId = 'loading_' + Date.now();
      chatContainer.innerHTML += '<div class="groq-msg-bubble groq-msg-agent" id="' + loadingId + '"><i class="fa-solid fa-spinner fa-spin"></i> Merespon...</div>';
      chatContainer.scrollTop = chatContainer.scrollHeight;

      groqConversation.push({ role: 'user', content: q });

      executeGroqRequest(groqConversation, function(err, responseText) {
        const loadingElem = document.getElementById(loadingId);
        if (loadingElem) loadingElem.remove();

        if (err) {
          chatContainer.innerHTML += '<div class="groq-msg-bubble groq-msg-agent" style="color:#dc2626;">Error: ' + err + '</div>';
        } else {
          groqConversation.push({ role: 'assistant', content: responseText });
          chatContainer.innerHTML += '<div class="groq-msg-bubble groq-msg-agent"><div style="white-space:pre-wrap;">' + escapeHtml(responseText) + '</div></div>';
        }
        chatContainer.scrollTop = chatContainer.scrollHeight;
      });
    }

    function executeGroqRequest(messages, callback) {
      let chatModel = systemGroqModel || 'openai/gpt-oss-120b';
      const key = systemGroqKey || localStorage.getItem('akshara_groq_key') || '';

      if (key) {
        fetch('https://api.groq.com/openai/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + key
          },
          body: JSON.stringify({
            model: chatModel,
            messages: messages,
            temperature: 0.2,
            max_tokens: 1024
          })
        })
        .then(r => r.json())
        .then(data => {
          if (data && data.choices && data.choices[0] && data.choices[0].message) {
            callback(null, data.choices[0].message.content);
          } else {
            callback(data.error ? data.error.message : 'Struktur response Groq tidak valid.');
          }
        })
        .catch(e => callback(e.toString()));
      } else {
        runApi('askGroq', { messages: messages, model: chatModel })
          .then(res => {
            if (res && res.status === 'success' && res.text) callback(null, res.text);
            else callback(res.message || 'Server error.');
          })
          .catch(err => callback(err.toString()));
      }
    }

    function extractAiFields(text) {
      lastAiDiagnosisText = '';
      lastAiPlanText = '';

      const lines = text.split('\n');
      let isPlan = false;
      let diagLines = [];
      let planLines = [];

      for (let i = 0; i < lines.length; i++) {
        const l = lines[i];
        if (l.toLowerCase().includes('diagnos') || l.toLowerCase().includes('icd')) {
          diagLines.push(l);
        } else if (l.toLowerCase().includes('plan') || l.toLowerCase().includes('terapi') || l.toLowerCase().includes('tindakan')) {
          isPlan = true;
          planLines.push(l);
        } else if (isPlan) {
          planLines.push(l);
        }
      }

      lastAiDiagnosisText = diagLines.join('\n') || text.substring(0, 150);
      lastAiPlanText = planLines.slice(0, 5).join('\n') || 'Sesuai anjuran klinis dokter gigi';
    }

