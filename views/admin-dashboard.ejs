        switchStaffSection('farmasi');
        loadPharmacyOrders();
      } else if (role === 'Laboratorium') {
        html += '<button class="tab-btn active" onclick="switchStaffSection(\'lab\')"><i class="fa-solid fa-flask-vial"></i> Order Uji Lab & Rontgen</button>';
        switchStaffSection('lab');
