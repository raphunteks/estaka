    let speechRecognitionInstance = null;
    function toggleSpeechRecognition(targetFieldId) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      const icon = document.getElementById('micIcon_' + targetFieldId);

      if (!SpeechRecognition) {
        showToast('Peramban belum mendukung Speech Recognition API.', 'error');
        return;
      }

      if (speechRecognitionInstance) {
        speechRecognitionInstance.stop();
        speechRecognitionInstance = null;
        if (icon) icon.style.color = '';
        showToast('Perekaman suara berhenti.', 'info');
        return;
      }

      speechRecognitionInstance = new SpeechRecognition();
      speechRecognitionInstance.lang = 'id-ID';
      speechRecognitionInstance.continuous = false;
      speechRecognitionInstance.interimResults = false;

      if (icon) icon.style.color = '#ef4444';
      showToast('Mendengarkan suara dokter...', 'info');

      speechRecognitionInstance.onresult = function(event) {
        const transcript = event.results[0][0].transcript;
        const target = document.getElementById(targetFieldId);
        if (target) {
          target.value = (target.value ? (target.value + ' ') : '') + transcript;
        }
        showToast('Suara berhasil dicatat!', 'success');
      };

      speechRecognitionInstance.onerror = function() {
        if (icon) icon.style.color = '';
        speechRecognitionInstance = null;
      };

      speechRecognitionInstance.onend = function() {
        if (icon) icon.style.color = '';
        speechRecognitionInstance = null;
      };

      speechRecognitionInstance.start();
    }

