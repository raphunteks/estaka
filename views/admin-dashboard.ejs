    function switchAdminSubSection(sub) {
      const btnAi = document.getElementById('subTabAdminAiBtn');
      const btnWeb = document.getElementById('subTabAdminWebBtn');
      const secAi = document.getElementById('adminSubSectionAi');
      const secWeb = document.getElementById('adminSubSectionWeb');

      if (sub === 'web') {
        btnWeb.classList.add('active');
        btnAi.classList.remove('active');
        secWeb.style.display = 'block';
        secAi.style.display = 'none';
      } else {
        btnAi.classList.add('active');
        btnWeb.classList.remove('active');
        secAi.style.display = 'block';
        secWeb.style.display = 'none';
      }
    }

    function refreshStaffView() {
      if (!currentUser) return;
      if (currentUser.role === 'Dokter' || currentUser.role === 'Admin') loadDoctorQueueData();
      if (currentUser.role === 'Farmasi') loadPharmacyOrders();
